[Unit]
Description=Poll Visayan Electric Facebook page into accoworks.dev/power
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/veco-poll.env
ExecStart=/usr/bin/python3 /opt/veco-poll/veco-poll.py
DynamicUser=yes
StateDirectory=veco-poll
Environment=VECO_STATE_DIR=/var/lib/veco-poll
