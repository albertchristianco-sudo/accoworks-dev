---
import EditionLayout from '../layouts/EditionLayout.astro';
import Cover from '../components/edition/Cover.astro';
import NoteList from '../components/edition/NoteList.astro';
import ProjectsFeature from '../components/edition/ProjectsFeature.astro';
import Profile from '../components/edition/Profile.astro';
import Colophon from '../components/edition/Colophon.astro';
import { getNotes, noteHref } from '../lib/notes';

const notes = await getNotes();
const pullSource = notes.find((note) => note.id.replace(/\.mdx?$/, '') === 'the-it-guy-was-there-first');
---

<EditionLayout
  title="Ac | Coach, builder and operator in Cebu"
  description="Albert Christian Co (Ac) runs two CrossFit gyms in Cebu, serves as Country Manager for CrossFit Philippines, operates a building materials business, and builds tools around the problems those jobs reveal."
  variant="cover"
>
  <Cover slot="cover" notes={notes.slice(0, 3)} />

  <section class="contents" id="field-notes" aria-labelledby="fn-title">
    <div class="contents__letter">
      <p class="contents__lede">I run two CrossFit gyms in Cebu, serve as Country Manager for CrossFit Philippines, and operate a building materials business. I build tools around the problems those jobs reveal. Training keeps me honest. Family keeps the work in perspective.</p>
      <p class="contents__links">
        <a class="btn btn--solid" href="/field-notes/">Read the writing</a>
        <a class="btn" href="/projects/">See what I build</a>
      </p>
      <figure class="contents__sig">
        <picture>
          <source type="image/avif" srcset="/avatar-160.avif 160w, /avatar-440.avif 440w" sizes="64px" />
          <source type="image/webp" srcset="/avatar-160.webp 160w, /avatar-440.webp 440w" sizes="64px" />
          <img src="/avatar-160.webp" width="160" height="160" alt="Ac" loading="lazy" decoding="async" />
        </picture>
        <figcaption>Albert Christian Co. Goes by Ac.</figcaption>
      </figure>
    </div>

    <div class="contents__page">
      <div class="contents__head">
        <h2 id="fn-title">Field Notes</h2>
        <p>Notes from training, building, and operating in the real world.</p>
      </div>
      <NoteList notes={notes.slice(0, 6)} lead />
      <p class="contents__all"><a href="/field-notes/">All Field Notes</a></p>
    </div>
  </section>

  {pullSource && (
    <figure class="pull" aria-labelledby="pull-src">
      <blockquote class="pull__quote">
        <p><span class="pull__line">It was never a shift.</span> <span class="pull__line">It was a return.</span> <span class="pull__line">The IT guy was there first.</span></p>
      </blockquote>
      <figcaption class="pull__src" id="pull-src">From <a href={noteHref(pullSource)}>{pullSource.data.title}</a></figcaption>
    </figure>
  )}

  <ProjectsFeature />
  <Profile />
  <Colophon />
</EditionLayout>
