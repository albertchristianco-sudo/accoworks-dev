---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  minimalNav
  noindex
  title="Log a rotational brownout | accoworks.dev"
  description="Paste a Visayan Electric rotational brownout advisory so it appears on the Cebu outage tracker."
>
  <section class="paste" aria-labelledby="paste-title">
    <h1 id="paste-title">Log a rotational brownout</h1>
    <p class="lede">
      The poller on uther-mini normally picks these up from Facebook every 15 minutes. This form
      is the manual override: paste the advisory text and its time slots, cities, barangays and map
      links go live on <a href="/power/">/power</a> immediately — no deploy. Pasting an hourly
      update keeps the earlier slots and replaces repeats.
    </p>

    <p class="ingest" data-ingest role="status">Checking auto-ingest…</p>

    <form data-form>
      <label for="token">Token</label>
      <input id="token" name="token" type="password" data-token autocomplete="current-password" />

      <label for="source">Post permalink <span class="opt">optional</span></label>
      <input id="source" name="source" type="url" data-source placeholder="https://www.facebook.com/…" />

      <label for="text">Advisory text</label>
      <textarea id="text" name="text" data-text rows="14" placeholder="ONGOING ROTATIONAL BROWNOUT&#10;11:00AM-12:00PM | SEPTEMBER 3, 2026&#10;Portion of Cebu City: Calamba, Capitol Site, Guadalupe&#10;View the map here: https://tinyurl.com/…"></textarea>

      <div class="actions">
        <button type="submit" class="btn btn-primary" data-submit>Parse and publish</button>
        <label class="switch"><input type="checkbox" data-replace /> <span>Replace the whole log</span></label>
        <button type="button" class="btn btn-ghost" data-clear>Clear log</button>
      </div>

      <p class="status" data-status role="status"></p>
    </form>

    <div class="result" data-result hidden>
      <h2>Stored</h2>
      <ul data-list></ul>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Same component vocabulary as /power: the role scale from global.css, matching
     control heights, and the status tokens rather than re-typed hex values. */
  .paste {
    max-width: 46rem;
    padding: clamp(24px, 5vw, 44px) 0 72px;
  }

  .paste h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-page);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .paste .lede {
    margin: 12px 0 24px;
    max-width: 60ch;
    color: var(--ink-2);
    font-size: var(--text-body);
  }

  .paste .lede a { color: var(--accent); }

  .paste label {
    display: block;
    margin: 16px 0 8px;
    color: var(--ink-2);
    font-size: var(--text-label);
    font-weight: 600;
  }

  .paste .opt {
    color: var(--ink-3);
    font-weight: 400;
  }

  .paste input,
  .paste textarea {
    width: 100%;
    padding: 12px 14px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--text-body);
  }

  .paste input::placeholder,
  .paste textarea::placeholder { color: var(--ink-3); }

  .paste input:focus-visible,
  .paste textarea:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  .paste input { min-height: 46px; padding: 0 14px; }

  .paste textarea {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: 1.6;
    resize: vertical;
  }

  .paste .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
  }

  .paste .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 16px;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--text-body);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 180ms var(--ease), border-color 180ms var(--ease), color 180ms var(--ease);
  }

  .paste .btn-primary {
    color: var(--accent-ink);
    background: var(--accent);
    border: 1px solid var(--accent);
  }

  .paste .btn-primary:hover { background: #1D4FD0; border-color: #1D4FD0; }
  .paste .btn-primary:active { background: #1A44B8; border-color: #1A44B8; }

  .paste .btn-ghost {
    margin-left: auto;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-2);
  }

  .paste .btn-ghost:hover { background: var(--surface-hover); border-color: var(--accent-line); }
  .paste .btn-ghost:active { background: var(--bg-2); }

  .paste .btn:disabled { opacity: 0.45; cursor: not-allowed; }
  .paste .btn[aria-busy='true'] { color: var(--ink-3); cursor: progress; }

  .paste .switch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    margin: 0;
    color: var(--ink-2);
    font-size: var(--text-label);
    font-weight: 400;
  }

  .paste .switch input { width: 16px; height: 16px; min-height: 0; accent-color: var(--accent); }

  .paste .ingest {
    margin: 0 0 24px;
    padding: 12px 14px;
    color: var(--ink-2);
    background: var(--surface-2);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    line-height: 1.6;
  }

  .paste .ingest[data-tone='error'] { color: var(--out); background: var(--out-soft); }
  .paste .ingest[data-tone='ok'] { color: var(--clear); background: var(--clear-soft); }

  .paste .status {
    margin: 16px 0 0;
    min-height: 1.4em;
    font-size: var(--text-label);
  }

  .paste .status[data-tone='error'] { color: var(--out); }
  .paste .status[data-tone='ok'] { color: var(--clear); }

  .paste .result { margin-top: 24px; }

  .paste .result h2 {
    margin: 0 0 8px;
    font-size: var(--text-lead);
    font-weight: 600;
  }

  .paste .result ul {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .paste .result li {
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }

  @media (pointer: coarse) {
    .paste .switch { min-height: 44px; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const token = document.querySelector<HTMLInputElement>('[data-token]')!;
  const source = document.querySelector<HTMLInputElement>('[data-source]')!;
  const text = document.querySelector<HTMLTextAreaElement>('[data-text]')!;
  const replace = document.querySelector<HTMLInputElement>('[data-replace]')!;
  const submit = document.querySelector<HTMLButtonElement>('[data-submit]')!;
  const clear = document.querySelector<HTMLButtonElement>('[data-clear]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const result = document.querySelector<HTMLElement>('[data-result]')!;
  const list = document.querySelector<HTMLElement>('[data-list]')!;
  const ingestLine = document.querySelector<HTMLElement>('[data-ingest]')!;

  const TOKEN_KEY = 'accoworks:power:token';
  token.value = localStorage.getItem(TOKEN_KEY) || '';

  const say = (message: string, tone: 'ok' | 'error' | 'neutral' = 'neutral') => {
    status.textContent = message;
    status.dataset.tone = tone;
  };

  const show = (items: { date: string; start: string; end: string; area: string; via?: string }[]) => {
    result.hidden = items.length === 0;
    list.innerHTML = items
      .map((item) => `<li>${item.date} ${item.start}–${item.end} · ${item.area} · ${item.via || 'paste'}</li>`)
      .join('');
  };

  const STALE_MS = 45 * 60 * 1000;
  const hhmm = (iso: string | null) =>
    iso ? new Date(iso).toLocaleTimeString('en-PH', { timeZone: 'Asia/Manila', hour: 'numeric', minute: '2-digit' }) : 'never';

  type Health = {
    checkedAt: string | null;
    latestPostId: string | null;
    latestPostAt: string | null;
    result: string | null;
    detail: string;
    pinned: boolean;
    lastErrorAt: string | null;
  };

  function showIngest(health: Health) {
    const checked = health.checkedAt ? Date.parse(health.checkedAt) : 0;
    const errored = health.lastErrorAt ? Date.parse(health.lastErrorAt) > checked : false;
    const stale = !checked || Date.now() - checked > STALE_MS;
    // On an error the record keeps the last successful `result` and swaps `detail` for the
    // error text, so the detail belongs to the "errored" clause, not to "last result".
    const parts = [
      `Auto-ingest: checked ${hhmm(health.checkedAt)}`,
      `latest VECO post ${hhmm(health.latestPostAt)}`,
      `last result ${health.result || 'none'}${!errored && health.detail ? ` (${health.detail})` : ''}`,
    ];
    if (errored) parts.push(`errored ${hhmm(health.lastErrorAt)}${health.detail ? ` (${health.detail})` : ''}`);
    if (health.pinned) parts.push('VECO has a pinned post; automatic pickup may lag');
    ingestLine.textContent = parts.join(' · ');
    ingestLine.dataset.tone = stale || errored || health.result === 'rejected' ? 'error' : 'ok';
  }

  async function send(method: 'POST' | 'DELETE') {
    if (!token.value.trim()) return say('Token first.', 'error');
    localStorage.setItem(TOKEN_KEY, token.value.trim());
    const active = method === 'DELETE' ? clear : submit;
    active.setAttribute('aria-busy', 'true');
    submit.disabled = true;
    clear.disabled = true;
    say(method === 'DELETE' ? 'Clearing…' : 'Parsing…');

    try {
      const response = await fetch('/api/rotational', {
        method,
        headers: { 'content-type': 'application/json', authorization: `Bearer ${token.value.trim()}` },
        body: method === 'POST'
          ? JSON.stringify({ text: text.value, source: source.value.trim(), replace: replace.checked, via: 'paste' })
          : undefined,
      });
      const data = await response.json();
      if (!response.ok) {
        say(`${data.error || 'Failed'}${data.warnings?.length ? ` — ${data.warnings.join('; ')}` : ''}`, 'error');
        return;
      }
      show(data.items || []);
      const warned = data.warnings?.length ? ` (${data.warnings.join('; ')})` : '';
      say(
        method === 'DELETE'
          ? 'Log cleared.'
          : `Published ${data.added} slot${data.added === 1 ? '' : 's'}; ${data.stored} live.${warned}`,
        'ok',
      );
      if (method === 'POST') text.value = '';
    } catch (error) {
      say(`Request failed: ${(error as Error).message}`, 'error');
    } finally {
      active.removeAttribute('aria-busy');
      submit.disabled = false;
      clear.disabled = false;
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    void send('POST');
  });

  clear.addEventListener('click', () => {
    if (confirm('Clear every logged rotational brownout?')) void send('DELETE');
  });

  fetch('/api/rotational')
    .then((r) => r.json())
    .then((data) => {
      show(data.items || []);
      if (data.updated) say(`Log last updated ${new Date(data.updated).toLocaleString('en-PH', { timeZone: 'Asia/Manila' })}.`);
    })
    .catch(() => {});

  fetch('/api/rotational-health')
    .then((r) => r.json())
    .then(showIngest)
    .catch(() => {
      ingestLine.textContent = 'Auto-ingest: status unavailable.';
      ingestLine.dataset.tone = 'error';
    });
</script>
