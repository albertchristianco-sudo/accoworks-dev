---
import EditionLayout from '../../layouts/EditionLayout.astro';
import NoteList from '../../components/edition/NoteList.astro';
import { getNotes } from '../../lib/notes';

const notes = await getNotes();
const filters = [
  { id: 'f-all', label: 'Everything' },
  { id: 'f-training', label: 'Training' },
  { id: 'f-building', label: 'Building' },
  { id: 'f-operating', label: 'Operating' },
];
---

<EditionLayout title="Field Notes | accoworks.dev" description="Notes from training, building, and operating in the real world.">
  <div class="archive">
    <div class="archive__head">
      <h1>Field Notes</h1>
      <p>Notes from training, building, and operating in the real world.</p>
      <!-- CSS-only filter: radios plus :has(). Without :has support the fieldset stays hidden and every note shows. -->
      <fieldset class="filter">
        <legend>Show notes on</legend>
        <div class="filter__opts">
          {filters.map((filter, index) => (
            <>
              <input type="radio" name="label" id={filter.id} checked={index === 0} />
              <label for={filter.id}>{filter.label}</label>
            </>
          ))}
        </div>
      </fieldset>
      <p class="filter__note">{notes.length} notes, newest first.</p>
    </div>
    {notes.length > 0 ? (
      <NoteList notes={notes} labelled class="archive__list" />
    ) : (
      <p class="archive__list">No notes published yet.</p>
    )}
  </div>
</EditionLayout>
