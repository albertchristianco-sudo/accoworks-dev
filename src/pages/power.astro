---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Will I have a power interruption? | Cebu outage tracker';
const description =
  'Check whether Visayan Electric has a power interruption scheduled for your barangay in Metro Cebu: what time it starts, how long it lasts, and when power returns.';
---

<BaseLayout title={title} description={description} image="/og-power.png">
  <section class="outage" aria-labelledby="outage-title">
    <header class="ask">
      <h1 id="outage-title">Will I have a power interruption in my area?</h1>
      <p class="ask-lede">
        Read straight from Visayan Electric’s published advisories for Metro Cebu. Cebu time,
        next 14 days.
      </p>

      <form class="locator" data-form novalidate>
        <label for="area">Your barangay, street or city</label>
        <div class="field-row">
          <input
            id="area"
            name="area"
            type="text"
            data-search
            placeholder="e.g. Talamban, Mabolo, Guadalupe"
            autocomplete="address-level4"
            enterkeyhint="search"
            aria-describedby="area-desc"
            spellcheck="false"
          />
          <button type="submit" class="btn btn-primary" data-check>Check</button>
          <button type="button" class="btn btn-ghost" data-locate>
            <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
              <circle cx="10" cy="10" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7" />
              <circle cx="10" cy="10" r="6.6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-dasharray="3.2 3.4" />
              <path d="M10 1v2.2M10 16.8V19M1 10h2.2M16.8 10H19" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
            </svg>
            Use my location
          </button>
        </div>
        <p class="field-hint visually-hidden" id="area-desc">Type a barangay, street or city in Metro Cebu.</p>
        <p class="field-hint" role="status" data-hint>Or let the browser read your location once.</p>
      </form>
    </header>

    <div class="verdict" data-verdict data-tone="idle" aria-live="polite">
      <div class="verdict-mark" data-verdict-mark aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M16.2 16.2 21 21"/></svg>
      </div>
      <div class="verdict-body">
        <p class="verdict-head" data-verdict-head>Loading today’s advisories…</p>
        <p class="verdict-detail" data-verdict-detail>Reading Visayan Electric’s published schedule.</p>
        <p class="verdict-stale" data-verdict-stale hidden></p>
        <p class="verdict-meta" data-verdict-meta hidden></p>
      </div>
    </div>

    <div class="toolbar" data-toolbar role="group" aria-label="Filter the schedule" hidden>
      <div class="chips" data-chips></div>
      <label class="switch">
        <input type="checkbox" data-hide-done checked />
        <span>Hide finished</span>
      </label>
      <label class="switch">
        <input type="checkbox" data-hide-possible />
        <span>Hide possible</span>
      </label>
    </div>

    <div class="feed" data-feed></div>

    <div class="note" data-empty hidden>
      <p>
        No advisory in the next 14 days mentions it. Try the barangay name on its own, or clear the
        filter to read the whole franchise schedule.
      </p>
      <button type="button" class="btn btn-ghost" data-clear>Clear filters</button>
    </div>

    <div class="note" data-failed hidden>
      <p>
        Nothing was reachable just now — this page reads Visayan Electric’s own site and their
        Facebook posts, and one of them did not answer.
      </p>
      <button type="button" class="btn btn-primary" data-retry>Try again</button>
    </div>

    <footer class="outage-foot">
      <p data-updated class="stamp"></p>
      <p>
        Unofficial mirror of
        <a href="https://www.visayanelectric.com/newsroom-blog" rel="noopener" target="_blank">Visayan Electric advisories</a>
        and their
        <a href="https://www.facebook.com/visayanelectriccompany" rel="noopener" target="_blank">Facebook announcements</a>.
        Rotational brownout posts are picked up from Facebook automatically every 15 minutes.
        Schedules get moved, extended and cancelled — confirm on the official channels before you
        plan a day around one.
      </p>
    </footer>
  </section>
</BaseLayout>

<!-- Rows are built at runtime from /api/outages, so Astro's scoped attributes never reach
     them. This block is global; every selector stays under .outage. -->
<style is:global>
  .outage { padding: clamp(24px, 5vw, 48px) 0 72px; }

  /* ── Ask ─────────────────────────────────────────────────────────────── */

  .outage .ask { max-width: 46rem; }

  .outage h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-page);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .outage .ask-lede {
    margin: 12px 0 0;
    max-width: 48ch;
    color: var(--ink-2);
    font-size: var(--text-body);
  }

  .outage .locator { margin-top: 24px; }

  .outage .locator label {
    display: block;
    margin-bottom: 8px;
    color: var(--ink-2);
    font-size: var(--text-label);
    font-weight: 600;
  }

  .outage .field-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    max-width: 38rem;
  }

  .outage input[type='text'] {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 46px;
    padding: 0 14px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-control);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--text-body);
  }

  .outage input[type='text']::placeholder { color: var(--ink-3); }

  .outage input[type='text']:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  .outage .field-hint {
    margin: 8px 0 0;
    color: var(--ink-3);
    font-size: var(--text-label);
  }

  /* A declined geolocation permission is a failed interface, not an outage. */
  .outage .field-hint[data-tone='error'] { color: var(--error); }

  .outage .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 16px;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--text-body);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 180ms var(--ease), border-color 180ms var(--ease), color 180ms var(--ease);
  }

  .outage .btn-primary {
    color: var(--accent-ink);
    background: var(--accent);
    border: 1px solid var(--accent);
  }

  .outage .btn-primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
  .outage .btn-primary:active { background: var(--accent-active); border-color: var(--accent-active); }

  .outage .btn-ghost {
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-2);
  }

  .outage .btn-ghost:hover { background: var(--surface-hover); border-color: var(--accent-line); }
  .outage .btn-ghost:active { background: var(--bg-2); }

  .outage .btn:disabled { opacity: 0.45; cursor: not-allowed; }
  /* Busy wins over disabled: the control is working, not forbidden. */
  .outage .btn[aria-busy='true'] { color: var(--ink-3); cursor: progress; }

  .outage .ico {
    width: 18px;
    height: 18px;
    flex: none;
  }

  /* ── Verdict ─────────────────────────────────────────────────────────── */

  .outage .verdict {
    display: flex;
    gap: 16px;
    margin: 24px 0 0;
    padding: 20px 24px;
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .outage .verdict[data-tone='out'] { background: var(--out-soft); }
  .outage .verdict[data-tone='wait'] { background: var(--wait-soft); }
  .outage .verdict[data-tone='clear'] { background: var(--clear-soft); }

  .outage .verdict-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: var(--ink-2);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .outage .verdict-mark svg { width: 22px; height: 22px; }
  .outage .verdict[data-tone='out'] .verdict-mark { color: var(--out); background: color-mix(in srgb, var(--out) 12%, transparent); }
  .outage .verdict[data-tone='wait'] .verdict-mark { color: var(--wait); background: color-mix(in srgb, var(--wait) 12%, transparent); }
  .outage .verdict[data-tone='clear'] .verdict-mark { color: var(--clear); background: color-mix(in srgb, var(--clear) 12%, transparent); }

  .outage .verdict-body { min-width: 0; }

  .outage .verdict-head {
    margin: 2px 0 0;
    font-family: var(--font-display);
    font-size: var(--text-answer);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    text-wrap: balance;
  }

  .outage .verdict[data-tone='out'] .verdict-head { color: var(--out); }
  .outage .verdict[data-tone='clear'] .verdict-head { color: var(--clear); }
  .outage .verdict[data-tone='wait'] .verdict-head { color: var(--wait); }

  .outage .verdict-detail {
    margin: 8px 0 0;
    color: var(--ink-2);
    font-size: var(--text-body);
    font-variant-numeric: tabular-nums;
  }

  /* Shown when the Facebook poller has gone quiet: the schedule on screen may be
     missing rotational updates, and the page has to say so rather than imply all-clear. */
  .outage .verdict-stale {
    margin: 10px 0 0;
    color: var(--wait);
    font-size: var(--text-label);
    font-weight: 500;
    line-height: 1.5;
  }

  .outage .verdict-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 12px 0 0;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
  }

  .outage .verdict-meta button {
    min-height: 32px;
    padding: 4px 0;
    color: var(--accent);
    background: none;
    border: 0;
    /* A control label, not data: sans, never the mono it would inherit. */
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    .outage .verdict[data-fresh] .verdict-body > * {
      animation: verdict-in 260ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .outage .verdict[data-fresh] .verdict-detail { animation-delay: 40ms; }
    .outage .verdict[data-fresh] .verdict-meta { animation-delay: 80ms; }
  }

  @keyframes verdict-in {
    from { opacity: 0; transform: translateY(6px); filter: blur(4px); }
    to { opacity: 1; transform: none; filter: none; }
  }

  /* ── Toolbar ─────────────────────────────────────────────────────────── */

  .outage .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin: 24px 0 4px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  /* `display: flex` outranks the UA's [hidden] rule, so say it here or the toolbar keeps
     showing two switches that filter nothing while the feed is empty or unreachable. */
  .outage .toolbar[hidden] { display: none; }

  .outage .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-right: auto;
  }

  .outage .chip {
    min-height: 36px;
    padding: 0 12px;
    color: var(--ink-2);
    background: transparent;
    border: 1px solid var(--line-control);
    border-radius: 999px;
    font: inherit;
    font-size: var(--text-label);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 160ms var(--ease), color 160ms var(--ease), border-color 160ms var(--ease);
  }

  .outage .chip:hover { background: var(--surface-hover); }
  .outage .chip:active { background: var(--bg-2); }

  .outage .chip[aria-pressed='true'] {
    color: var(--accent-ink);
    background: var(--ink);
    border-color: var(--ink);
  }

  .outage .chip[aria-pressed='true']:hover { background: var(--ink-hover); border-color: var(--ink-hover); }

  .outage .chip-n {
    margin-left: 8px;
    color: var(--ink-3);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .outage .chip[aria-pressed='true'] .chip-n { color: color-mix(in srgb, var(--accent-ink) 75%, transparent); }

  .outage .switch {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    color: var(--ink-2);
    font-size: var(--text-label);
    cursor: pointer;
  }

  .outage .switch input { width: 16px; height: 16px; accent-color: var(--accent); }

  /* ── Day sections and the hour rail ──────────────────────────────────── */

  .outage .day { margin: 24px 0 0; }

  .outage .day-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
  }

  .outage .day-name {
    margin: 0;
    font-size: var(--text-title);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .outage .day-date,
  .outage .day-count {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
  }

  .outage .day-count { margin-left: auto; }

  /* The rail is the page's one device: each day's outage windows drawn to scale
     across 24 hours, so the shape of the day is readable before the rows are. */
  .outage .rail {
    position: relative;
    height: 32px;
    margin: 12px 0 4px;
    border-bottom: 1px solid var(--line-2);
  }

  .outage .rail-tick {
    position: absolute;
    bottom: 0;
    width: 1px;
    height: 6px;
    background: var(--line-2);
  }

  .outage .rail-hour {
    position: absolute;
    bottom: 12px;
    white-space: nowrap;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    transform: translateX(-50%);
  }

  .outage .rail-hour[data-edge='start'] { transform: none; }
  .outage .rail-hour[data-edge='end'] { transform: translateX(-100%); }

  .outage .rail-block {
    position: absolute;
    bottom: 0;
    height: 9px;
    min-width: 2px;
    background: var(--ink-3);
    border-radius: 1px;
  }

  .outage .rail-block[data-state='live'] { background: var(--out); }
  .outage .rail-block[data-state='upcoming'] { background: var(--wait); }
  .outage .rail-block[data-state='cancelled'] { background: var(--line); }
  /* Possible slots read as provisional: same hue, lighter weight than a confirmed cut. */
  .outage .rail-block[data-possible] { background: var(--wait); opacity: 0.4; }

  .outage .rail-now {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
  }

  /* ── Rows ────────────────────────────────────────────────────────────── */

  .outage .row {
    display: grid;
    grid-template-columns: minmax(0, 11.5rem) minmax(0, 1fr) auto;
    align-items: start;
    gap: 4px 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    /* Three hundred-odd rows: letting the off-screen ones skip layout and paint is what
       keeps a keystroke cheap. The reserved height is a typical row's. */
    content-visibility: auto;
    contain-intrinsic-size: auto 140px;
  }

  .outage .row[data-state='done'],
  .outage .row[data-state='cancelled'] { color: var(--ink-3); }

  .outage .row-time {
    padding-top: 1px;
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* The range may break between its two clocks, never inside one. */
  .outage .row-clock { white-space: nowrap; }

  .outage .row[data-state='cancelled'] .row-time { text-decoration: line-through; }
  .outage .row[data-possible] .row-time { color: var(--ink-2); font-weight: 500; }

  .outage .row-span {
    display: block;
    margin-top: 4px;
    color: var(--ink-3);
    font-size: var(--text-meta);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .outage .row-area {
    margin: 0;
    max-width: 52ch;
    font-size: var(--text-body);
    font-weight: 600;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .outage .row-streets {
    margin: 4px 0 0;
    max-width: 68ch;
    color: var(--ink-2);
    font-size: var(--text-body);
    line-height: 1.55;
  }

  .outage .row[data-state='done'] .row-streets,
  .outage .row[data-state='cancelled'] .row-streets { color: var(--ink-3); }

  .outage .row-state {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: start;
    padding: 5px 10px;
    border-radius: 999px;
    /* A status label, not data: sans at the metadata step. */
    font-size: var(--text-meta);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .outage .row-state svg { width: 13px; height: 13px; }
  .outage .row-state[data-state='live'] { color: var(--out); background: var(--out-soft); }
  .outage .row-state[data-state='upcoming'] { color: var(--wait); background: var(--wait-soft); }
  .outage .row-state[data-state='done'],
  .outage .row-state[data-state='cancelled'] { color: var(--ink-3); background: var(--surface-2); }
  .outage .row-state[data-possible] { color: var(--wait); background: var(--wait-soft); }

  .outage details { margin: 8px 0 0; }

  .outage summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    color: var(--ink-3);
    font-size: var(--text-meta);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .outage summary::-webkit-details-marker { display: none; }
  .outage summary:hover { color: var(--accent); }
  .outage summary svg { width: 12px; height: 12px; transition: transform 160ms var(--ease); }
  .outage details[open] summary svg { transform: rotate(90deg); }

  .outage details p { margin: 8px 0 0; color: var(--ink-2); font-size: var(--text-body); max-width: 70ch; }
  .outage details a { color: var(--accent); }

  /* ── Loading, empty, footer ──────────────────────────────────────────── */

  .outage .skeleton {
    height: 14px;
    margin: 24px 0;
    background: linear-gradient(100deg, var(--surface-2) 30%, var(--bg-2) 50%, var(--surface-2) 70%);
    background-size: 220% 100%;
    border-radius: 3px;
  }

  .outage .skeleton:nth-child(2n) { width: 78%; }
  .outage .skeleton:nth-child(3n) { width: 61%; }

  @media (prefers-reduced-motion: no-preference) {
    .outage .skeleton { animation: sweep 1.5s var(--ease) infinite; }
  }

  @keyframes sweep {
    from { background-position: 120% 0; }
    to { background-position: -40% 0; }
  }

  .outage .note {
    padding: 24px 0 8px;
    max-width: 52ch;
  }

  .outage .note-head {
    margin: 0 0 8px;
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: 1.3;
  }

  .outage .note p { margin: 0 0 12px; color: var(--ink-2); font-size: var(--text-body); }

  .outage .outage-foot {
    margin: 36px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: var(--text-label);
  }

  .outage .outage-foot p { margin: 0 0 8px; max-width: 74ch; line-height: 1.55; }
  .outage .outage-foot a { color: var(--ink-2); }
  .outage .stamp { font-family: var(--font-mono); font-size: var(--text-meta); font-variant-numeric: tabular-nums; }

  /* Touch: the filter controls are the page's primary interaction on a phone. */
  @media (pointer: coarse) {
    .outage .chip,
    .outage .switch,
    .outage summary,
    .outage details a,
    .outage .verdict-meta button { min-height: 44px; }

    .outage .chip { padding: 0 16px; }
    /* An inline link is as tall as its line box: 20px on a page that raises everything
       else to 44. */
    .outage details a { display: inline-flex; align-items: center; }
  }

  @media (max-width: 620px) {
    .outage .btn-ghost { flex: 1 1 100%; }

    .outage .row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2px 12px;
      padding: 14px 0;
    }

    /* The time and its duration share the first track here, so the track's min-content
       is that whole string. Keep it breakable: unbroken, it pushes the status badge past
       a 320px viewport, and body{overflow-x:clip} destroys it rather than scrolls to it. */
    .outage .row-time { grid-column: 1; grid-row: 1; white-space: normal; }
    .outage .row-state { grid-column: 2; grid-row: 1; justify-self: end; white-space: normal; text-align: right; }
    .outage .row > div { grid-column: 1 / -1; grid-row: 2; margin-top: 4px; }
    .outage .row-span { display: inline; margin: 0 0 0 8px; }
    /* Keep only the anchors of the 24-hour scale when it is this narrow. */
    .outage .rail-hour[data-edge='mid'] { display: none; }
  }
</style>

<script>
  import { entryStatus, manilaDate } from '../scripts/outages.mjs';
  import {
    CITIES,
    badgeFor,
    citiesOf,
    clock,
    dayFull,
    dayKey,
    dayOffset,
    dayShort,
    isVisible,
    matches,
    verdictView,
  } from '../scripts/power-view.mjs';

  type Entry = {
    kind: 'scheduled' | 'rotational';
    start: string;
    end: string;
    hours: number;
    flag: string | null;
    area: string;
    streets: string;
    areasRaw: string;
    purpose: string;
    source: string;
    map?: string;
    possible?: boolean;
    postedAt?: string | null;
  };

  type Ingest = { checkedAt: string | null; latestPostAt: string | null };

  type Feed = {
    updated: string;
    entries?: Entry[];
    posts?: { title: string }[];
    ingest?: Ingest;
    warnings?: string[];
  };

  /** A verdict line: stable prose, plus the one countdown that moves every minute. */
  type Segment = string | { count: string };

  const el = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;

  const form = el<HTMLFormElement>('[data-form]');
  const search = el<HTMLInputElement>('[data-search]');
  const hint = el('[data-hint]');
  const locateBtn = el<HTMLButtonElement>('[data-locate]');
  const verdict = el('[data-verdict]');
  const verdictMark = el('[data-verdict-mark]');
  const verdictHead = el('[data-verdict-head]');
  const verdictDetail = el('[data-verdict-detail]');
  const verdictStale = el('[data-verdict-stale]');
  const verdictMeta = el('[data-verdict-meta]');
  const chipBox = el('[data-chips]');
  const hideDone = el<HTMLInputElement>('[data-hide-done]');
  const hidePossible = el<HTMLInputElement>('[data-hide-possible]');
  const feed = el('[data-feed]');
  const emptyNote = el('[data-empty]');
  const clearBtn = el<HTMLButtonElement>('[data-clear]');
  const toolbar = el('[data-toolbar]');
  const failedNote = el('[data-failed]');
  const retryBtn = el<HTMLButtonElement>('[data-retry]');
  const updated = el('[data-updated]');

  const AREA_KEY = 'accoworks:power:area';
  // Three missed 15-minute poller cycles. Judged against the feed's own timestamp, not
  // Date.now(), so a tab left open overnight does not invent a staleness warning.
  const INGEST_STALE_MS = 45 * 60 * 1000;
  // How old the payload itself may get before the minute tick re-reads it. A tab left
  // open during an outage is the normal case, and ageing the badges it loaded with is
  // not the same as following the schedule.
  const REFETCH_MS = 5 * 60 * 1000;
  // Long enough that an 8-character area name is one rebuild, short enough to feel live.
  const TYPE_DEBOUNCE_MS = 120;

  const ICONS = {
    out: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12z"/><path d="M3 3l18 18"/></svg>',
    wait: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3.2 2"/></svg>',
    clear: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6.5 9.6 17 4 11.4"/></svg>',
    idle: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M16.2 16.2 21 21"/></svg>',
  };

  const STATE_ICONS = {
    live: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12z"/><path d="M3 3l18 18"/></svg>',
    upcoming: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3.2 2"/></svg>',
    done: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6.5 9.6 17 4 11.4"/></svg>',
    cancelled: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 8l8 8M16 8l-8 8"/></svg>',
  };

  const stampFmt = new Intl.DateTimeFormat('en-PH', {
    timeZone: 'Asia/Manila',
    dateStyle: 'medium',
    timeStyle: 'short',
  });

  let entries: Entry[] = [];
  let city = '';
  let detected = '';
  let ingest: Ingest | undefined;
  let fetchedAt = Date.now();
  let lastFetch = 0;
  let feedSig = '';
  let chipSig = '';
  let loading = false;
  let typing = 0;
  let frame = 0;

  const esc = (value: string) =>
    value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  // One entry, one identity — shared by its row, its rail block and the minute tick.
  const keyOf = (entry: Entry) => `${entry.start}|${entry.area}`;

  const query = () => search.value.trim().toLowerCase();

  const filtered = (opts: { includeDone?: boolean } = {}) => {
    const needle = query();
    const now = Date.now();
    const hideFinished = !opts.includeDone && hideDone.checked;
    return entries.filter((entry) =>
      isVisible(entry, { city, needle, hidePossible: hidePossible.checked, hideDone: hideFinished, now }));
  };

  // Facebook is the only source of rotational brownouts, so an unread feed is a hole in
  // the answer, not a detail. A missing `ingest` (old payload, or the feed itself failed)
  // counts as stale: the honest default.
  const ingestStale = () =>
    !ingest?.checkedAt || fetchedAt - Date.parse(ingest.checkedAt) > INGEST_STALE_MS;

  const whenChecked = () => {
    if (!ingest?.checkedAt) return 'never';
    const at = new Date(ingest.checkedAt);
    const sameDay = dayKey(ingest.checkedAt) === manilaDate(fetchedAt);
    return sameDay ? `${clock.format(at)} today` : `${dayFull.format(at)}, ${clock.format(at)}`;
  };

  function renderStaleNotice() {
    const text = ingestStale()
      ? `Rotational brownout updates from Facebook may be missing: last automatic check ${whenChecked()}. ` +
        'Confirm on Visayan Electric’s Facebook page.'
      : '';
    // Inside the aria-live region: only write when it actually says something new.
    if (verdictStale.textContent === text) return;
    verdictStale.textContent = text;
    verdictStale.hidden = !text;
  }

  // The verdict is an aria-live region, and reassigning identical text still announces.
  // Stable prose is therefore rewritten only when the answer itself changed; the
  // countdown lives in an aria-live="off" span, so it can move every minute in silence.
  function paint(node: HTMLElement, segments: Segment[], rebuild: boolean) {
    if (rebuild) {
      node.textContent = '';
      for (const segment of segments) {
        if (typeof segment === 'string') {
          node.append(segment);
          continue;
        }
        const span = document.createElement('span');
        span.setAttribute('aria-live', 'off');
        span.textContent = segment.count;
        node.append(span);
      }
      return;
    }
    const spans = node.querySelectorAll<HTMLElement>('[aria-live="off"]');
    let index = 0;
    for (const segment of segments) {
      if (typeof segment === 'string') continue;
      const span = spans[index++];
      if (span && span.textContent !== segment.count) span.textContent = segment.count;
    }
  }

  function renderVerdict() {
    const view = verdictView({
      entries,
      scope: filtered({ includeDone: true }),
      // Echo the typed area back as a place name, not as raw keystrokes.
      label: query() ? search.value.trim().replace(/\b\p{Ll}/gu, (c) => c.toUpperCase()) : city,
      scoped: Boolean(query() || city),
      stale: ingestStale(),
      now: Date.now(),
    }) as { tone: keyof typeof ICONS; key: string; head: Segment[]; detail: Segment[] };

    // The identity of the answer, with no clock in it: a minute later it is the same key,
    // so nothing is announced and nothing is re-animated.
    const changed = verdict.dataset.key !== view.key;
    verdict.dataset.tone = view.tone;
    verdict.dataset.key = view.key;
    if (changed) verdictMark.innerHTML = ICONS[view.tone] || ICONS.idle;
    paint(verdictHead, view.head, changed);
    paint(verdictDetail, view.detail, changed);

    const meta = detected ? `Located: ${esc(detected)} <button type="button" data-reset>Not my area</button>` : '';
    if (verdictMeta.innerHTML !== meta) {
      verdictMeta.innerHTML = meta;
      verdictMeta.hidden = !detected;
    }

    if (!changed) return;

    // One authored moment: the answer settles in when it changes, never on every tick.
    verdict.removeAttribute('data-fresh');
    void verdict.offsetWidth;
    verdict.setAttribute('data-fresh', '');
  }

  function renderChips() {
    const counts = new Map<string, number>();
    for (const entry of entries) {
      for (const name of citiesOf(entry)) counts.set(name, (counts.get(name) || 0) + 1);
    }
    const rows: [string, string, number][] = [['All areas', '', entries.length]];
    for (const [name, count] of [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))) {
      rows.push([name, name, count]);
    }
    // Without the label the accessible name reads "Mandaue96".
    const html = rows
      .map(([label, value, count]) =>
        `<button type="button" class="chip" data-city="${esc(value)}" aria-pressed="${value === city}" aria-label="${esc(label)}, ${count} ${count === 1 ? 'interruption' : 'interruptions'}">${esc(label)}<span class="chip-n">${count}</span></button>`)
      .join('');
    // A background refresh that changes nothing must not replace the button under focus.
    if (html === chipSig) return;
    chipSig = html;
    chipBox.innerHTML = html;
  }

  function rail(group: Entry[], key: string, now: number) {
    const ticks = [0, 6, 12, 18, 24]
      .map((hour) => {
        const pct = (hour / 24) * 100;
        const edge = hour === 0 ? 'start' : hour === 24 ? 'end' : 'mid';
        const label = hour === 0 ? '12 AM' : hour === 12 ? '12 NN' : hour === 24 ? '12 MN' : `${hour > 12 ? hour - 12 : hour} ${hour < 12 ? 'AM' : 'PM'}`;
        return `<span class="rail-tick" style="left:${pct}%"></span><span class="rail-hour" data-edge="${edge}" style="left:${pct}%">${label}</span>`;
      })
      .join('');

    // Each block carries its row's key so the minute tick can age it in place.
    const blocks = group
      .map((entry) => {
        const from = dayOffset(entry.start, key);
        const to = dayOffset(entry.end, key);
        const state = entryStatus(entry, now).state;
        return `<span class="rail-block" data-key="${esc(keyOf(entry))}" data-state="${state}"${entry.possible ? ' data-possible' : ''} style="left:${(from / 1440) * 100}%;width:${Math.max(((to - from) / 1440) * 100, 0.4)}%"></span>`;
      })
      .join('');

    const marker = key === manilaDate(now)
      ? `<span class="rail-now" style="left:${(dayOffset(new Date(now).toISOString(), key) / 1440) * 100}%"></span>`
      : '';

    return `<div class="rail" data-day="${esc(key)}" aria-hidden="true">${ticks}${blocks}${marker}</div>`;
  }

  const CHEVRON =
    '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5"/></svg>';

  // A plain div, not an article: 336 article boundaries announced in a row is noise, and
  // naming each one only trades that for 336 redundant labels.
  function row(entry: Entry, now: number) {
    const state = entryStatus(entry, now).state;
    const overnight = dayKey(entry.start) !== dayKey(entry.end);
    const badge = badgeFor(entry, now);
    const tags = [
      entry.possible ? 'Possible rotational brownout' : entry.kind === 'rotational' ? 'Rotational brownout' : '',
      entry.flag && entry.flag !== 'cancelled' ? entry.flag : '',
    ].filter(Boolean).join(' · ');
    const iconState = entry.possible && state === 'live' ? 'upcoming' : (state as keyof typeof STATE_ICONS);

    return `
      <div class="row" data-state="${state}" data-key="${esc(keyOf(entry))}"${entry.possible ? ' data-possible' : ''}>
        <p class="row-time"><span class="row-clock">${clock.format(new Date(entry.start))}</span> – <span class="row-clock">${clock.format(new Date(entry.end))}</span>
          <span class="row-span">${entry.hours}h${overnight ? ' · ends next day' : ''}</span>
        </p>
        <div>
          <p class="row-area">${esc(entry.area)}</p>
          ${entry.streets ? `<p class="row-streets">${esc(entry.streets)}</p>` : ''}
          ${tags ? `<p class="row-streets">${esc(tags)}</p>` : ''}
          ${entry.purpose ? `<details><summary>${CHEVRON}Why</summary><p>${esc(entry.purpose)}</p>${entry.map ? `<p><a href="${esc(entry.map)}" rel="noopener" target="_blank">See the affected-area map</a></p>` : ''}${entry.source ? `<p><a href="${esc(entry.source)}" rel="noopener" target="_blank">Read the advisory</a></p>` : ''}${entry.postedAt ? `<p>Posted by Visayan Electric ${clock.format(new Date(entry.postedAt))}</p>` : ''}</details>` : ''}
        </div>
        <span class="row-state" data-state="${state}"${entry.possible ? ' data-possible' : ''}>${STATE_ICONS[iconState] || ''}${badge}</span>
      </div>`;
  }

  function renderFeed() {
    const list = filtered();
    const now = Date.now();

    const today = manilaDate(now);
    const groups = new Map<string, Entry[]>();
    for (const entry of list) {
      const key = dayKey(entry.start);
      groups.set(key, [...(groups.get(key) || []), entry]);
    }

    emptyNote.hidden = groups.size > 0;
    feed.innerHTML = [...groups.entries()]
      .sort((a, b) => a[0].localeCompare(b[0]))
      .map(([key, group]) => {
        const noon = new Date(`${key}T12:00:00+08:00`);
        const offset = Math.round(
          (Date.parse(`${key}T00:00:00+08:00`) - Date.parse(`${today}T00:00:00+08:00`)) / 86400000,
        );
        const name = offset === 0 ? 'Today' : offset === 1 ? 'Tomorrow' : offset === -1 ? 'Yesterday' : dayShort.format(noon);
        return `
          <section class="day">
            <div class="day-head">
              <h2 class="day-name">${name}</h2>
              <span class="day-date">${dayFull.format(noon)}</span>
              <span class="day-count">${group.length} ${group.length === 1 ? 'interruption' : 'interruptions'}</span>
            </div>
            ${rail(group, key, now)}
            ${group.map((entry) => row(entry, now)).join('')}
          </section>`;
      })
      .join('');
  }

  function render() {
    // Whatever was queued by typing is stale the moment anything else renders.
    clearTimeout(typing);
    cancelAnimationFrame(frame);
    renderVerdict();
    renderFeed();
  }

  // The minute tick only ages statuses. Patching the rows in place keeps open "Why"
  // panels open and keyboard focus where the user left it; a full rebuild would not.
  function refresh() {
    const now = Date.now();
    renderVerdict();

    const byKey = new Map(entries.map((entry) => [keyOf(entry), entry]));
    for (const node of feed.querySelectorAll<HTMLElement>('.row[data-key]')) {
      const entry = byKey.get(node.dataset.key || '');
      if (!entry) continue;
      const state = entryStatus(entry, now).state;
      const pill = node.querySelector<HTMLElement>('.row-state');
      if (node.dataset.state !== state) {
        node.dataset.state = state;
        if (pill) {
          pill.dataset.state = state;
          const iconState = entry.possible && state === 'live' ? 'upcoming' : (state as keyof typeof STATE_ICONS);
          pill.innerHTML = `${STATE_ICONS[iconState] || ''}${badgeFor(entry, now)}`;
          continue;
        }
      }
      if (pill) {
        const badge = badgeFor(entry, now);
        const label = pill.lastChild;
        if (label && label.textContent !== badge) label.textContent = badge;
      }
    }

    // The rail is drawn once per render, so its blocks age here too — otherwise a window
    // that just went live keeps the amber it was painted with while its row turns red.
    for (const block of feed.querySelectorAll<HTMLElement>('.rail-block[data-key]')) {
      const entry = byKey.get(block.dataset.key || '');
      if (!entry) continue;
      const state = entryStatus(entry, now).state;
      if (block.dataset.state !== state) block.dataset.state = state;
    }

    for (const railNode of feed.querySelectorAll<HTMLElement>('.rail[data-day]')) {
      const marker = railNode.querySelector<HTMLElement>('.rail-now');
      if (marker) marker.style.left = `${(dayOffset(new Date(now).toISOString(), railNode.dataset.day!) / 1440) * 100}%`;
    }
  }

  function setHint(message: string, tone: 'neutral' | 'error' = 'neutral') {
    hint.textContent = message;
    hint.dataset.tone = tone;
  }

  // Remember whatever narrowed the view — typed area or the city we fell back to.
  function remember() {
    const value = search.value.trim() || city;
    if (value) localStorage.setItem(AREA_KEY, value);
    else localStorage.removeItem(AREA_KEY);
  }

  async function locate() {
    if (!navigator.geolocation) {
      setHint('This browser cannot share a location. Type your barangay instead.', 'error');
      return;
    }
    locateBtn.setAttribute('aria-busy', 'true');
    locateBtn.disabled = true;
    setHint('Asking your browser for a location…');

    try {
      const position = await new Promise<GeolocationPosition>((resolve, reject) => {
        navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 12000, maximumAge: 300000 });
      });
      const { latitude, longitude } = position.coords;
      const response = await fetch(`/api/where?lat=${latitude.toFixed(5)}&lon=${longitude.toFixed(5)}`);
      const place = await response.json();
      if (!response.ok) throw new Error(place.error || 'lookup failed');

      detected = place.label || '';
      const barangay = place.barangay || place.city || '';
      search.value = barangay;
      city = '';

      // A barangay with no advisory is the common case: fall back to its city so the
      // answer still shows what is happening around the user.
      if (barangay && !entries.some((entry) => matches(entry, barangay.toLowerCase()))) {
        const cityHit = CITIES.find(([, re]: [string, RegExp]) => re.test(String(place.city || '').toLowerCase()));
        if (cityHit) {
          search.value = '';
          city = cityHit[0];
          setHint(`Nothing scheduled for ${barangay} itself — showing ${cityHit[0]}.`);
        } else {
          setHint(`Located ${detected}.`);
        }
      } else {
        setHint(`Located ${detected}.`);
      }

      remember();
      renderChips();
      render();
    } catch (error) {
      const denied = (error as GeolocationPositionError)?.code === 1;
      setHint(
        denied
          ? 'Location permission was declined. Type your barangay instead.'
          : 'Could not work out your location. Type your barangay instead.',
        'error',
      );
    } finally {
      locateBtn.removeAttribute('aria-busy');
      locateBtn.disabled = false;
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    detected = '';
    city = '';
    remember();
    renderChips();
    render();
    setHint(search.value.trim() ? 'Showing every advisory that mentions it.' : 'Or let the browser read your location once.');
  });

  // The answer follows every keystroke; the 336-row list follows one frame after typing
  // settles, because rebuilding it is style and paint on thousands of nodes.
  search.addEventListener('input', () => {
    detected = '';
    renderVerdict();
    clearTimeout(typing);
    typing = window.setTimeout(() => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(renderFeed);
    }, TYPE_DEBOUNCE_MS);
  });

  locateBtn.addEventListener('click', locate);
  hideDone.addEventListener('change', render);
  hidePossible.addEventListener('change', render);

  chipBox.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.chip');
    if (!button) return;
    city = button.dataset.city === city ? '' : button.dataset.city || '';
    renderChips();
    render();
    // renderChips() replaced the button that was just pressed; put focus back on it.
    chipBox.querySelector<HTMLButtonElement>(`[data-city="${CSS.escape(city)}"]`)?.focus();
  });

  verdictMeta.addEventListener('click', (event) => {
    if (!(event.target as HTMLElement).closest('[data-reset]')) return;
    detected = '';
    search.value = '';
    city = '';
    localStorage.removeItem(AREA_KEY);
    renderChips();
    render();
    search.focus();
  });

  clearBtn.addEventListener('click', () => {
    search.value = '';
    city = '';
    detected = '';
    localStorage.removeItem(AREA_KEY);
    renderChips();
    render();
    search.focus();
  });

  function stampFooter(data: Feed) {
    const advisories = (data.posts || []).map((post) => post.title).join(' · ');
    const facebook = ingestStale()
      ? ` · Facebook not checked since ${whenChecked()}`
      : ` · Facebook checked ${clock.format(new Date(ingest!.checkedAt!))}`;
    const latest = ingest?.latestPostAt
      ? ` · latest VECO post ${clock.format(new Date(ingest.latestPostAt))}`
      : '';
    // A half-read advisory is news, not something to swallow: the API says which post it
    // could not parse, so the stamp says it too.
    const warnings = data.warnings?.length ? ` · ${data.warnings.join(' · ')}` : '';
    updated.textContent =
      `Checked ${stampFmt.format(new Date(data.updated))} · ${entries.length} interruptions${facebook}${latest}` +
      `${advisories ? ` · ${advisories}` : ''}${warnings}`;
  }

  // One load path for the first paint and for every refresh. Nothing on screen is
  // replaced until the payload has parsed, so a failed re-read keeps the last schedule.
  // Returns whether the schedule itself moved: `updated` is stamped per request, so the
  // entries are the only honest signal, and a tab regaining focus should not rebuild
  // 336 rows — closing every open "Why" — just to redraw the same day.
  async function load() {
    const response = await fetch('/api/outages');
    if (!response.ok) throw new Error(`feed responded ${response.status}`);
    const data = (await response.json()) as Feed;

    lastFetch = Date.now();
    const sig = JSON.stringify(data.entries || []);
    const moved = sig !== feedSig;
    feedSig = sig;
    entries = data.entries || [];
    ingest = data.ingest;
    fetchedAt = Date.parse(data.updated) || Date.now();
    stampFooter(data);
    return moved;
  }

  async function reload() {
    if (loading) return;
    loading = true;
    try {
      const moved = await load();
      // A reload that succeeds after a failed first read is a recovery: clear the failure
      // note and bring the filters back rather than waiting for a manual retry.
      failedNote.hidden = true;
      toolbar.hidden = entries.length === 0;
      renderStaleNotice();
      if (moved) {
        renderChips();
        render();
      } else {
        refresh();
      }
    } catch (error) {
      // The schedule already on screen beats a blank page; try again on the next tick.
      console.error(error);
      refresh();
    } finally {
      loading = false;
    }
  }

  const saved = localStorage.getItem(AREA_KEY);
  if (saved) {
    // A remembered city restores as the chip filter; anything else as the search term.
    if (CITIES.some(([name]: [string, RegExp]) => name === saved)) city = saved;
    else search.value = saved;
    setHint('Using the area you checked last time.');
  }

  async function boot() {
    failedNote.hidden = true;
    feed.innerHTML = '<div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>';
    try {
      await load();
      renderChips();
      renderStaleNotice();
      render();
      toolbar.hidden = entries.length === 0;
    } catch (error) {
      // One voice for one failure: the verdict says the schedule could not be read, so the
      // staleness notice (which blames the Facebook poller) would be a second, wronger
      // explanation of the same outage. The toolbar filters nothing, so it goes too.
      feed.innerHTML = '';
      emptyNote.hidden = true;
      toolbar.hidden = true;
      verdictStale.hidden = true;
      verdictStale.textContent = '';
      renderVerdict();
      failedNote.hidden = false;
      updated.textContent = 'Advisory feed unreachable.';
      console.error(error);
    }
  }

  retryBtn.addEventListener('click', () => {
    retryBtn.setAttribute('aria-busy', 'true');
    retryBtn.disabled = true;
    void boot().finally(() => {
      retryBtn.removeAttribute('aria-busy');
      retryBtn.disabled = false;
    });
  });

  await boot();

  // The tick ages the badges and the rail; once the payload itself is old it gets re-read,
  // and a tab coming back into view always does. Installed even if the first read failed,
  // so an unreachable feed recovers on its own.
  setInterval(() => {
    if (Date.now() - lastFetch > REFETCH_MS) void reload();
    else refresh();
  }, 60000);

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) void reload();
  });
</script>
