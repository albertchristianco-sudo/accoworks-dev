---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FRANCHISE, fold } from '../scripts/franchise.mjs';

const title = 'Will I have a power interruption? | Cebu outage tracker';
const description =
  'Check whether Visayan Electric has a power interruption scheduled for your barangay in Cebu City, Mandaue, Talisay, Naga, Liloan, Consolacion, Minglanilla or San Fernando: what time it starts, how long it lasts, and when power returns.';

type Suggestion = { value: string; lgus: string[] };

// The barangay suggestions, built here at build time from the franchise roster: no runtime
// fetch and no client script for any of it. Deduped by folded name so one spelling is
// offered once, and where a name belongs to more than one LGU the single option says which,
// because that is the case a reader has to settle before trusting a row.
const suggestions: Suggestion[] = [];
const byFold = new Map<string, Suggestion>();
for (const lgu of FRANCHISE) {
  for (const barangay of lgu.barangays) {
    const key = fold(barangay);
    const seen = byFold.get(key);
    if (seen) {
      if (!seen.lgus.includes(lgu.name)) seen.lgus.push(lgu.name);
      continue;
    }
    const option: Suggestion = { value: barangay, lgus: [lgu.name] };
    byFold.set(key, option);
    suggestions.push(option);
  }
}

/** "Banilad, in Cebu City and Mandaue". A label only earns its place on a collision. */
const optionLabel = ({ value, lgus }: Suggestion) =>
  lgus.length < 2 ? undefined : `${value}, in ${lgus.slice(0, -1).join(', ')} and ${lgus[lgus.length - 1]}`;
---

<BaseLayout title={title} description={description} image="/og-power.png">
  <section class="outage" aria-labelledby="outage-title">
    <header class="ask">
      <p class="power-context">POWER / CEBU</p>
      <h1 id="outage-title">Will I have a power interruption in my area?</h1>
      <p class="trust-line">
        Visayan Electric’s published interruption schedule, refreshed automatically. Every time is Cebu time.
      </p>

      <div class="task-zone">
        <form class="locator" data-form novalidate>
          <label for="area">Your barangay, street or city</label>
          <div class="ask-row">
            <div class="field">
              <svg class="field-ico" viewBox="0 0 20 20" aria-hidden="true">
                <circle cx="9" cy="9" r="5.4" fill="none" stroke="currentColor" stroke-width="1.7" />
                <path d="M13.1 13.1 17.4 17.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
              </svg>
              <input
                id="area"
                name="area"
                type="text"
                data-search
                list="barangays"
                placeholder="Barangay, street or city"
                autocomplete="address-level4"
                enterkeyhint="search"
                aria-autocomplete="list"
                aria-describedby="area-desc"
                spellcheck="false"
              />
              <!-- Shown by CSS off :placeholder-shown once the reader types or geolocation fills
                   the field, and it never sits in the tab order empty. -->
              <button type="button" class="field-clear" data-clear-input aria-label="Clear">
                <svg viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M6 6l8 8M14 6l-8 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                </svg>
              </button>
            </div>
            <button type="submit" class="btn" data-check>Check my area</button>
          </div>
          <datalist id="barangays">
            {suggestions.map((item) => <option value={item.value} label={optionLabel(item)} />)}
          </datalist>
          <p class="search-aux">
            <button type="button" class="txtbtn" data-locate>
              <svg class="ico" viewBox="0 0 20 20" aria-hidden="true">
                <circle cx="10" cy="10" r="3.2" fill="none" stroke="currentColor" stroke-width="1.7" />
                <circle cx="10" cy="10" r="6.6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-dasharray="3.2 3.4" />
                <path d="M10 1v2.2M10 16.8V19M1 10h2.2M16.8 10H19" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
              </svg>
              Use my location
            </button>
          </p>
          <p class="field-hint visually-hidden" id="area-desc">
            Type a barangay, street or city in Visayan Electric’s franchise: Cebu City, Mandaue,
            Talisay, Naga, Liloan, Consolacion, Minglanilla or San Fernando. Suggestions are
            offered as you type.
          </p>
          <p class="field-hint" data-hint>Type an area, then check the published schedule.</p>
        </form>

        <div class="verdict" data-verdict data-tone="idle">
          <span class="verdict-mark" data-verdict-mark aria-hidden="true" hidden></span>
          <div class="verdict-body">
            <div class="verdict-summary">
              <p class="verdict-head" data-verdict-head tabindex="-1">Tell me where you are</p>
              <p class="verdict-detail" data-verdict-detail>Type your barangay, street or city for a local answer.</p>
              <span class="visually-hidden" data-answer-announcement aria-live="polite" aria-atomic="true"></span>
            </div>
            <div class="answer-sources" data-answer-sources hidden>
              <a href="https://www.visayanelectric.com/serviceinterruptioncalendar" rel="noopener" target="_blank" aria-label="Open Visayan Electric’s official service interruption calendar">Official interruption calendar</a>
              <p data-rotational-context>Rotational windows are used only if NGCP, the national grid operator, asks Visayan Electric to reduce load.</p>
              <p class="fyi-status" data-fyi-status hidden>
                <a href="https://fyi.aboitizpower.com/" rel="noopener" target="_blank">AboitizPower FYI</a>
                <span data-fyi-status-copy></span>
              </p>
            </div>
            <p class="verdict-confidence" data-confidence>Checking the published schedule in Cebu time.</p>
            <p class="verdict-meta" data-verdict-meta hidden></p>
            <div class="verdict-actions" data-verdict-actions hidden>
              <button type="button" class="txtbtn" data-reset hidden>Not my area</button>
              <button type="button" class="txtbtn" data-retry hidden>Try again</button>
            </div>
            <div class="city-prompt" data-city-prompt hidden></div>
          </div>
        </div>
        <div class="evidence" data-evidence hidden></div>
      </div>
    </header>

    <section class="browse" aria-labelledby="browse-title">
      <div class="browse-head">
        <h2 id="browse-title">Published schedule</h2>
        <p>Today’s published window is ready below. Open the schedule to filter every record by city, type, day, or finished history.</p>
      </div>

      <details class="browse-disclosure" data-browse>
        <summary class="browse-toggle">
          <span>Browse schedule</span>
          <span class="browse-preview" data-browse-preview>Loading the published schedule…</span>
        </summary>
        <div class="browse-panel">
          <div class="toolbar" data-toolbar role="group" aria-label="Filter the schedule" hidden>
            <fieldset class="types">
              <legend>Interruption type</legend>
              <label class="check">
                <input type="checkbox" data-type="scheduled" checked />
                <span>Scheduled</span>
              </label>
              <label class="check">
                <input type="checkbox" data-type="emergency" checked />
                <span>Emergency</span>
              </label>
              <label class="check">
                <input type="checkbox" data-type="rotational" checked />
                <span>Rotational</span>
              </label>
            </fieldset>
            <label class="check history-toggle">
              <input type="checkbox" data-show-finished />
              <span>Include finished history</span>
            </label>
          </div>

          <p class="note" data-toolbar-note hidden>
            Possible rotational brownouts are mapped windows, not confirmed outages. Visayan Electric
            carries them out only if NGCP calls for load reduction that day.
          </p>

          <nav class="cities" data-cities aria-label="City scope" hidden>
            <p class="cities-lab">City scope</p>
            <div class="chips" data-chips></div>
          </nav>

          <h3 class="list-head" data-range>Published schedule</h3>
          <nav class="fortnight" data-fortnight aria-label="Published days" hidden></nav>

          <div class="feed" data-feed></div>

          <div class="empty" data-empty hidden>
            <p data-empty-line></p>
            <button type="button" class="txtbtn" data-clear>Show everything</button>
          </div>

          <div class="empty" data-empty-feed hidden>
            <p data-empty-feed-line></p>
          </div>
        </div>
      </details>
    </section>

    <footer class="outage-foot">
      <p class="stamp" data-updated></p>
      <p class="sources">
        <a href="https://www.visayanelectric.com/serviceinterruptioncalendar" rel="noopener" target="_blank">Visayan Electric service interruption calendar</a>
        <a href="https://www.facebook.com/visayanelectriccompany" rel="noopener" target="_blank">Visayan Electric on Facebook</a>
        <a href="https://fyi.aboitizpower.com/" rel="noopener" target="_blank">AboitizPower FYI</a>
      </p>
      <p class="fine">
        An unofficial mirror of Visayan Electric’s Service Interruption Calendar, checked
        automatically. Facebook is supplementary for updates that have not reached the calendar.
      </p>
      <p class="fine">
        Visayan Electric distributes to 8 local governments, and this page can only answer for
        those: Cebu City, Mandaue, Talisay, Naga, Liloan, Consolacion, Minglanilla and San
        Fernando. Lapu-Lapu, Olango and Cordova are Mactan Electric. Danao, Compostela, Carmen
        and Bogo are Cebu II Electric Cooperative. Carcar, Barili and Dumanjug are Cebu I.
        Toledo, Balamban and Asturias are Cebu III. Interruptions in those areas are announced
        by those utilities and never appear here.
      </p>
      <p class="fine">
        Schedules get moved, shortened, extended and cancelled without notice. Confirm on the
        official channels before you plan a day around one.
      </p>
      <p class="built">
        Built by <a href="https://andar.ph" rel="noopener" target="_blank">Andar</a>, a software
        and AI company in Cebu. We build the systems that make an operation run.
      </p>
    </footer>
  </section>
</BaseLayout>

<!-- Rows are built at runtime from /api/outages, so Astro's scoped attributes never reach
     them. This block is global; every selector stays under .outage. -->
<style is:global>
  /* ── Shell and this page's own tokens ────────────────────────────────── */

  .outage {
    /* Derived from house ink so the row bar and the day rail read as one instrument.
       Declared here, never in global.css: this is one page's vocabulary. */
    --bar-next: rgba(13, 21, 38, 0.7);
    --bar-done: rgba(13, 21, 38, 0.18);
    --strip-next: rgba(13, 21, 38, 0.55);
    --strip-done: rgba(13, 21, 38, 0.16);
    /* "Possible" is a pattern fill that encodes a state, not a decorative gradient. The
       amber wash under the stripes is what lets stacked hatches darken at all. */
    --hatch: repeating-linear-gradient(135deg, var(--wait) 0 1.5px, transparent 1.5px 4px);
    --hit: var(--accent-soft);

    max-width: 60rem;
    padding: clamp(24px, 5vw, 48px) 0 72px;
  }

  .outage .power-context {
    margin: 0 0 8px;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.06em;
  }

  /* The search hit, washed in place instead of wrapped in a <mark>: no DOM churn per
     keystroke. Where the API is missing the wash silently does not appear. */
  .outage ::highlight(hit) { background-color: var(--hit); color: var(--ink); }

  /* ── Ask ─────────────────────────────────────────────────────────────── */

  .outage h1 {
    margin: 0;
    max-width: 20em;
    font-family: var(--font-display);
    font-size: var(--text-page);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .outage .trust-line {
    margin: 12px 0 0;
    max-width: 42em;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.5;
  }

  .outage .task-zone { margin-top: 28px; }
  .outage .locator { margin: 0; }

  .outage .locator > label {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
  }

  /* The field and its Check read as one control from 560px up; below that Check stacks
     under it and goes full width. */
  .outage .ask-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    max-width: 34em;
  }

  /* A surface, a boundary all round and a magnifier: at a glance this is something you
     type into, which a 1px bottom rule alone never said. Still not a card. */
  .outage .field {
    position: relative;
    display: flex;
    flex: 1 1 15em;
    align-items: center;
    height: 56px;
    background: var(--surface);
    /* 0.47 alpha ink: the 3:1 a control boundary needs. Anything lighter is decoration. */
    border: 1px solid var(--line-control);
    border-radius: var(--radius);
    transition: border-color 150ms var(--ease), box-shadow 150ms var(--ease);
  }

  .outage .field-ico {
    position: absolute;
    left: 16px;
    width: 18px;
    height: 18px;
    color: var(--ink-3);
    pointer-events: none;
  }

  .outage input[type='text'] {
    display: block;
    width: 100%;
    min-width: 0;
    height: 100%;
    padding: 0 4px 0 46px;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-radius: var(--radius);
    font-family: var(--font-sans);
    font-size: clamp(18px, 3.4vw, 22px);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .outage input[type='text']::placeholder { color: var(--ink-3); opacity: 1; }
  .outage input[type='text']:focus { outline: none; }

  /* Chrome draws its own black arrow for a `list` input, off-brand and right where the clear
     sits. The magnifier and type-ahead are the affordance, and suggestions still filter as
     you type, which is all Safari and Firefox ever offered. The !important is not a shortcut:
     Chrome's UA sheet wins this pseudo-element without it, verified in the browser. */
  .outage input[type='text']::-webkit-calendar-picker-indicator { display: none !important; }

  /* 2px of accent drawn as a 1px border plus a 1px inset shadow, so nothing about the box
     changes size on focus. Never a padding swap here: the icon is positioned off this edge. */
  .outage .field:focus-within {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  /* The keyboard ring belongs to the whole control, not to the text inside its border. */
  .outage .field:has(input:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; }

  /* Only ever meaningful when there is something to clear, and the placeholder is the tell:
     no keystroke listener, and no invisible button in the tab order. */
  .outage .field-clear {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    /* 44 square, centred in the control rather than stretched to it: the touch target the
       guideline asks for, and a focus ring that clears the field's own border. */
    width: 44px;
    height: 44px;
    margin-right: 4px;
    padding: 0;
    color: var(--ink-3);
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: color 160ms var(--ease);
  }

  .outage .field-clear:hover { color: var(--ink); }
  .outage .field-clear:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
  .outage .field-clear svg { width: 20px; height: 20px; }
  .outage input[type='text']:placeholder-shown ~ .field-clear { display: none; }

  /* Check is the page's one solid action. It stays the submit, which is what makes Enter
     answer at all. */
  .outage .btn {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    color: var(--accent-ink);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
    cursor: pointer;
    transition: background-color 160ms var(--ease), border-color 160ms var(--ease);
  }

  .outage .btn:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
  .outage .btn:active { background: var(--accent-active); border-color: var(--accent-active); }
  .outage .btn:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  @media (max-width: 559px) {
    .outage .btn { width: 100%; }
  }

  .outage .search-aux {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 12px 0 0;
  }

  .outage .txtbtn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    padding: 0;
    color: var(--accent);
    background: none;
    border: 0;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
    transition: color 160ms var(--ease);
  }

  .outage .txtbtn:hover { color: var(--accent-hover); }
  .outage .txtbtn:disabled { color: var(--ink-3); cursor: not-allowed; }
  /* Busy wins over disabled: the control is working, not forbidden. */
  .outage .txtbtn[aria-busy='true'] { color: var(--ink-3); cursor: progress; }

  .outage .ico { width: 16px; height: 16px; flex: none; }

  .outage .field-hint {
    margin: 8px 0 0;
    max-width: 34em;
    color: var(--ink-3);
    font-size: 13px;
    line-height: 1.5;
  }

  /* A declined geolocation permission is a failed interface, not an outage. */
  .outage .field-hint[data-tone='error'] { color: var(--error); }

  /* ── Verdict ─────────────────────────────────────────────────────────── */

  .outage .verdict {
    position: relative;
    margin: 32px 0 0;
  }

  /* The answer's tone as a rule, not a card: 3px of colour in the gutter. The site shell
     keeps 16px of margin at every width, so -12px never reaches the viewport edge. */
  .outage .verdict-mark {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: -12px;
    width: 3px;
  }

  .outage .verdict[data-tone='out'] .verdict-mark { background: var(--out); }
  .outage .verdict[data-tone='wait'] .verdict-mark { background: var(--wait); }
  .outage .verdict[data-tone='clear'] .verdict-mark { background: var(--clear); }

  .outage .verdict-body { min-width: 0; }

  .outage .verdict-head {
    margin: 0;
    max-width: 27em;
    font-size: clamp(22px, 3.6vw, 28px);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.25;
    letter-spacing: -0.018em;
    text-wrap: pretty;
  }

  .outage .verdict[data-tone='out'] .verdict-head { color: var(--out); }
  .outage .verdict[data-tone='wait'] .verdict-head { color: var(--wait); }
  .outage .verdict[data-tone='clear'] .verdict-head { color: var(--clear); }
  /* Before the first paint there is no answer yet, only the promise of one. */
  .outage .verdict:not([data-key]) .verdict-head { color: var(--ink-2); }

  .outage .verdict-detail {
    margin: 12px 0 0;
    max-width: 32em;
    color: var(--ink-2);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }

  .outage .verdict-confidence {
    margin: 12px 0 0;
    max-width: 42em;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    line-height: 1.55;
  }

  .outage .verdict-meta {
    margin: 12px 0 0;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
  }

  .outage .verdict-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    margin: 12px 0 0;
  }

  .outage .verdict-actions[hidden],
  .outage .verdict-actions [hidden] { display: none; }


  .outage .answer-sources {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
    max-width: 42em;
    margin-top: 12px;
    color: var(--ink-2);
    font-size: 13px;
    line-height: 1.5;
  }

  .outage .answer-sources[hidden],
  .outage .answer-sources .fyi-status[hidden],
  .outage .city-prompt[hidden] { display: none; }

  .outage .answer-sources a { color: var(--accent); font-weight: 500; }
  .outage .answer-sources p { margin: 0; }
  .outage .answer-sources .fyi-status {
    flex-basis: 100%;
    min-width: 0;
    margin-top: 2px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }
  .outage .answer-sources .fyi-status span { overflow-wrap: anywhere; }
  .outage .answer-sources .fyi-status span::before { content: ' '; }

  .outage .city-prompt {
    max-width: 42em;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .outage .city-prompt p {
    margin: 0;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.5;
  }

  .outage .city-choices {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .outage .city-choices button {
    min-width: 44px;
    min-height: 44px;
    padding: 0 12px;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line-control);
    border-radius: var(--radius-sm);
    font: 500 14px/1.2 var(--font-sans);
    cursor: pointer;
  }

  .outage .city-choices button:hover { border-color: var(--accent); color: var(--accent); }
  .outage .city-choices button:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  .outage .evidence {
    max-width: 42em;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .outage .evidence-title {
    margin: 0 0 8px;
    color: var(--ink-2);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
  }

  .outage .evidence ol {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .outage .evidence li {
    padding: 12px 0;
    border-top: 1px solid var(--line);
  }

  .outage .evidence li:first-child { border-top: 0; }
  .outage .evidence p { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .outage .evidence-match { color: var(--ink); font-family: var(--font-mono); font-size: 12px; font-variant-numeric: tabular-nums; line-height: 1.55; }
  .outage .evidence-scope { margin-top: 8px; }
  .outage .evidence-scope summary,
  .outage .more-dates summary,
  .outage .archive-more summary {
    display: inline-flex;
    list-style: none;
    align-items: center;
    min-height: 44px;
    padding: 0;
    color: var(--accent);
    background: transparent;
    border: 0;
    font: 500 13px/1.4 var(--font-sans);
    letter-spacing: 0;
    text-transform: none;
    cursor: pointer;
  }

  .outage .evidence-scope summary::-webkit-details-marker,
  .outage .more-dates summary::-webkit-details-marker,
  .outage .archive-more summary::-webkit-details-marker { display: none; }
  .outage .evidence-scope summary:focus-visible,
  .outage .more-dates summary:focus-visible,
  .outage .archive-more summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .outage .evidence-official { margin-top: 4px !important; color: var(--ink-2); font-size: 14px; line-height: 1.55; }

  /* ── Browse ──────────────────────────────────────────────────────────── */

  .outage .browse {
    margin-top: clamp(48px, 7vw, 72px);
    padding-top: 24px;
    border-top: 1px solid var(--line-2);
  }

  .outage .browse-head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .outage .browse-head p {
    max-width: 42em;
    margin: 8px 0 0;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.5;
  }

  .outage .browse-disclosure {
    margin-top: 18px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .outage .browse-toggle {
    display: flex;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 16px;
    min-height: 56px;
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
    cursor: pointer;
  }
  .outage .browse-toggle > span:first-child { font-size: 16px; font-weight: 600; }
  .outage .browse-preview {
    max-width: 32em;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    text-align: right;
  }

  .outage .browse-toggle:focus-visible { outline: 3px solid var(--accent); outline-offset: -3px; }
  .outage .browse-panel { padding: 20px 0 28px; }

  .outage .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px 24px;
    margin: 0;
  }

  /* `display: flex` outranks the UA's [hidden] rule. */
  .outage .toolbar[hidden] { display: none; }

  .outage .types {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .outage .types legend,
  .outage .cities-lab {
    margin: 0 12px 0 0;
    color: var(--ink-2);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
  }

  .outage .check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
  }

  .outage .check input { width: 16px; height: 16px; margin: 0; accent-color: var(--accent); }
  .outage .history-toggle { color: var(--ink-2); }

  .outage .note {
    margin: 12px 0 0;
    max-width: 42em;
    color: var(--wait);
    font-size: 13px;
    line-height: 1.5;
  }

  .outage .cities { margin-top: 24px; }

  .outage .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: 8px;
  }

  .outage .chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 0;
    color: var(--ink);
    background: none;
    border: 0;
    font-family: var(--font-sans);
    text-align: left;
    cursor: pointer;
  }

  .outage .chip-name { font-size: 13px; font-weight: 500; line-height: 1.4; }
  .outage .chip-n { color: var(--ink-2); font-family: var(--font-mono); font-size: 11px; font-weight: 500; font-variant-numeric: tabular-nums; }
  .outage .chip-tick { display: none; }
  .outage .chip[data-quiet] .chip-name { color: var(--ink-3); }
  .outage .chip[aria-pressed='true'] .chip-name { text-decoration: underline; text-underline-offset: 3px; }

  .outage .list-head {
    margin: 28px 0 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
  }

  /* ── Published date controls ─────────────────────────────────────────── */

  .outage .fortnight { margin-top: 12px; }
  .outage .date-set {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .outage .fn-day {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 5px;
    min-width: 44px;
    min-height: 52px;
    padding: 6px 8px;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line-control);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    text-align: left;
    cursor: pointer;
  }

  .outage .fn-weekday { color: var(--ink-2); font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; }
  .outage .fn-date { min-width: 0; font-size: 13px; font-weight: 600; line-height: 1.2; white-space: nowrap; }
  .outage .fn-count { color: var(--ink-2); font-family: var(--font-mono); font-size: 11px; font-weight: 500; font-variant-numeric: tabular-nums; }
  .outage .fn-day[data-past] { color: var(--ink-2); }
  .outage .fn-day[data-live] .fn-count { color: var(--out); }
  .outage .fn-day[data-today],
  .outage .fn-day[aria-pressed='true'] { border-color: var(--accent); }
  .outage .fn-day:hover { border-color: var(--accent); color: var(--accent); }
  .outage .fn-day:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }

  .outage .more-dates { margin-top: 12px; }
  .outage .more-dates .date-set { margin-top: 4px; }

  .outage .archive-more { margin-top: 32px; }
  .outage .archive-more .day { margin-top: 24px; }
  .outage .day:focus-visible { outline: 3px solid var(--accent); outline-offset: 6px; }

  /* ── Day sections and the hour rail ──────────────────────────────────── */

  /* Days separate more than rows do, and clear the sticky site header when the fortnight
     rule scrolls to one. */
  .outage .day {
    margin: 48px 0 0;
    scroll-margin-top: 80px;
  }

  .outage .day-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0 8px;
    border-bottom: 1px solid var(--line-2);
  }

  .outage .day-name {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    min-width: 0;
    margin: 0;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.2;
  }

  .outage .day-rel { font-weight: 600; letter-spacing: -0.01em; }

  /* A tab-like underline under the word, not a chip. */
  .outage .day-rel[data-today] { padding-bottom: 2px; border-bottom: 2px solid var(--ink); }

  .outage .day-date,
  .outage .day-count {
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    white-space: nowrap;
  }

  .outage .day-date { letter-spacing: 0.04em; text-transform: uppercase; }

  /* The rail is the page's one device at day scale: every window that starts that day,
     drawn to scale across 24 hours. 22px of plot plus a 14px label row, exactly 36px at
     one row or at seventy-five. */
  .outage .rail {
    position: relative;
    height: 36px;
    margin: 8px 0 4px;
  }

  .outage .rail::after {
    content: '';
    position: absolute;
    top: 21px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--line-2);
  }

  .outage .rail-tick {
    position: absolute;
    top: 16px;
    width: 1px;
    height: 5px;
    background: var(--line-2);
  }

  .outage .rail-hour {
    position: absolute;
    top: 25px;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: 0.06em;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .outage .rail-hour[data-edge='start'] { transform: none; }
  .outage .rail-hour[data-edge='end'] { transform: translateX(-100%); }

  /* Density is alpha stacking, not lane assignment: two windows overlapping darken, one
     stacked band of seventy-five goes solid, and the rail never changes height. */
  .outage .rail-block {
    position: absolute;
    top: 13px;
    height: 8px;
    min-width: 2px;
    background: var(--strip-next);
  }

  .outage .rail-block[data-state='done'] { background: var(--strip-done); }
  .outage .rail-block[data-state='live'] { background: var(--out); }

  /* Hatched blocks carry the same 0.16 wash the ink fills use: stripes alone align in
     phase, so stacked hatches would never darken. */
  .outage .rail-block[data-possible] {
    background-color: color-mix(in srgb, var(--wait) 16%, transparent);
    background-image: var(--hatch);
  }

  .outage .rail-block[data-possible][data-state='done'] { opacity: 0.35; }

  /* Ink, not hue: the same cursor as the row bars and the now line. */
  .outage .rail-now {
    position: absolute;
    top: -4px;
    bottom: 13px;
    width: 1px;
    background: var(--ink);
  }

  /* ── Rows ────────────────────────────────────────────────────────────── */

  .outage .row {
    position: relative;
    display: grid;
    grid-template-areas:
      'time body state'
      'bar  body state';
    grid-template-columns: 148px minmax(0, 1fr) 128px;
    grid-template-rows: auto 1fr;
    column-gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }

  /* Three hundred-odd rows: letting the off-screen ones skip layout and paint is what
     keeps a keystroke cheap. Live rows opt out, because paint containment would clip the
     gutter rule below; there are 0 to 5 of them in 300. */
  .outage .row:not([data-state='live']) {
    content-visibility: auto;
    contain-intrinsic-size: auto 190px;
  }

  /* Scannable while flinging the scroll in a way a 13px word is not, and only where power
     is actually out: a possible window inside its slot gets a hatch, never a red rule. */
  .outage .row[data-state='live']:not([data-possible])::before {
    content: '';
    position: absolute;
    top: -1px;
    bottom: -1px;
    left: -12px;
    width: 3px;
    background: var(--out);
  }

  .outage .row-time { grid-area: time; }

  .outage .row-range {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* Two lines on desktop, and never a break inside one clock. */
  .outage .row-clock { display: block; white-space: nowrap; }

  .outage .row[data-state='cancelled'] .row-range { text-decoration: line-through; }

  .outage .row-span,
  .outage .row-next {
    margin: 2px 0 0;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }

  .outage .row-next { font-family: var(--font-sans); }

  /* The row's own 24-hour axis, which is what retired the 6px state dot. The clocks above
     it are the accessible version. */
  .outage .row-bar {
    position: relative;
    grid-area: bar;
    align-self: start;
    height: 10px;
    margin-top: 8px;
  }

  .outage .row-bar::before {
    content: '';
    position: absolute;
    top: 5px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--line);
  }

  /* Quarter-day ticks under the row bar, and every line in it is a time. The day rail
     draws its own through .rail-tick spans. */
  .outage .ticks::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 4px;
    background-image:
      linear-gradient(var(--line-2), var(--line-2)),
      linear-gradient(var(--line-2), var(--line-2)),
      linear-gradient(var(--line-2), var(--line-2)),
      linear-gradient(var(--line-2), var(--line-2)),
      linear-gradient(var(--line-2), var(--line-2));
    background-repeat: no-repeat;
    background-size: 1px 100%;
    background-position: 0% 100%, 25% 100%, 50% 100%, 75% 100%, 100% 100%;
  }

  .outage .row-seg {
    position: absolute;
    top: 3px;
    height: 4px;
    min-width: 2px;
    background: var(--bar-next);
  }

  .outage .row[data-state='done'] .row-seg { background: var(--bar-done); }
  .outage .row[data-state='live'] .row-seg { background: var(--out); }

  .outage .row[data-state='cancelled'] .row-seg {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--ink-3);
  }

  .outage .row[data-state='cancelled'] .row-seg::after {
    content: '';
    position: absolute;
    top: 1px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--ink-3);
  }

  /* Possible outranks every confirmed fill: a mapped window NGCP never called is not an
     outage, whatever the clock says. */
  .outage .row[data-possible] .row-seg { background: var(--hatch); }
  .outage .row[data-possible][data-state='done'] .row-seg { opacity: 0.35; }
  /* A cancelled possible slot is neither a live hatch nor a future window. */
  .outage .row[data-state='cancelled'][data-possible] .row-seg {
    background: transparent;
    opacity: 1;
  }

  .outage .row-now {
    position: absolute;
    top: 0;
    width: 1px;
    height: 10px;
    background: var(--ink);
  }

  .outage .row-body { grid-area: body; min-width: 0; }

  .outage .row-area {
    margin: 0;
    font-size: 17px;
    line-height: 1.4;
    letter-spacing: -0.011em;
    text-wrap: pretty;
  }

  /* Streets keep a one-line clamp; that toggle appears on string length, never measured. */
  .outage .row-streets {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
    overflow: hidden;
    margin: 4px 0 0;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.5;
  }

  .outage .row-streets.open {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: unset;
    overflow: visible;
  }

  .outage .row-tags {
    margin: 4px 0 0;
    color: var(--ink-3);
    font-size: 13px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  /* Ink with a hairline underline, not a link: a day of 75 clamped rows must not read as
     75 blue links. */
  .outage .row-more {
    padding: 0;
    color: var(--ink);
    background: none;
    border: 0;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 2px;
    cursor: pointer;
  }

  .outage .row-area .row-more { margin-left: 6px; }
  .outage .row-streets-more { display: inline-block; margin-top: 8px; }

  .outage details { margin: 8px 0 0; }

  .outage summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    color: var(--ink-3);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .outage summary::-webkit-details-marker { display: none; }
  .outage summary:hover,
  .outage details[open] summary { color: var(--ink); }
  .outage summary svg { width: 10px; height: 10px; transition: transform 160ms var(--ease); }
  .outage details[open] summary svg { transform: rotate(90deg); }

  .outage .why-body {
    margin-top: 12px;
    max-width: 44em;
    padding-left: 12px;
    border-left: 1px solid var(--line);
  }

  .outage .why-body p { margin: 0 0 8px; color: var(--ink-2); font-size: 14px; line-height: 1.55; }
  .outage .why-body p:last-child { margin-bottom: 0; }
  .outage .why-body a { color: var(--accent); font-size: 13px; }

  .outage .row-state { grid-area: state; padding-top: 1px; text-align: right; }

  .outage .row-word {
    display: block;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
  }

  .outage .row[data-state='live'] .row-word { color: var(--out); font-weight: 600; }
  .outage .row[data-state='live'][data-possible] .row-word { color: var(--wait); }
  .outage .row[data-state='upcoming'] .row-word { color: var(--ink-2); }
  .outage .row[data-state='upcoming'][data-when='today'] .row-word { color: var(--ink); }

  .outage .row[data-state='done'] .row-word,
  .outage .row[data-state='cancelled'] .row-word,
  .outage .row[data-state='unknown'] .row-word { color: var(--ink-3); font-weight: 400; }

  .outage .row-sub {
    display: block;
    margin-top: 2px;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }

  .outage .row[data-state='done'] .row-area,
  .outage .row[data-state='cancelled'] .row-area,
  .outage .row[data-state='done'] .row-range,
  .outage .row[data-state='cancelled'] .row-range { color: var(--ink-2); }

  /* ── The now line ────────────────────────────────────────────────────── */

  /* One 1px rule at page scale, the same cursor as the row bars and the day rail.
     Everything above it has started; everything below is still ahead. */
  .outage .now-line {
    position: relative;
    height: 0;
    margin-top: -1px;
    border-top: 1px solid var(--ink);
  }

  /* Nothing has started yet today, so the line sits straight under the rail. Its label
     and the rail's own "12 MN" would otherwise read as one cramped stack. */
  .outage .rail + .now-line { margin-top: 10px; }

  .outage .now-line span {
    position: absolute;
    top: -7px;
    right: 0;
    padding-left: 8px;
    color: var(--ink);
    background: var(--bg);
    font: 600 11px/1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── Loading, empty, footer ──────────────────────────────────────────── */

  /* Placeholders on the real row grid, with solid rules where the bars go. A sweeping
     gradient would be decoration pretending to be progress. */
  .outage .skel .sk { display: block; height: 10px; background: var(--line); }
  .outage .skel .sk-t { width: 84%; height: 12px; }
  .outage .skel .sk-a { width: 62%; height: 12px; }
  .outage .skel .sk-b { width: 38%; margin-top: 8px; }

  .outage .skel .sk-bar {
    position: absolute;
    top: 3px;
    left: 12%;
    width: 34%;
    height: 4px;
    background: var(--line);
  }

  .outage .empty {
    margin: 48px 0 0;
    max-width: 34em;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.5;
  }

  .outage .empty p { margin: 0; }
  .outage .empty .txtbtn { margin-top: 8px; }
  .outage .empty .txtbtn[hidden] { display: none; }


  .outage .outage-foot {
    margin: 96px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line-2);
  }

  .outage .stamp {
    margin: 0;
    max-width: 44em;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    line-height: 1.55;
  }

  .outage .sources {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 12px 0 24px;
    font-size: 13px;
  }

  .outage .sources a { color: var(--accent); text-decoration-color: currentcolor; }

  .outage .fine {
    margin: 0 0 12px;
    max-width: 44em;
    color: var(--ink-2);
    font-size: 13px;
    line-height: 1.6;
  }

  .outage .outage-foot > p:last-child { margin-bottom: 0; }

  /* Who made this. One line, the fine-print register, on its own rule so it reads as a
     signature and not as another disclaimer. */
  .outage .built {
    margin: 24px 0 0;
    padding-top: 16px;
    max-width: 44em;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 13px;
    line-height: 1.6;
  }

  .outage .built a {
    color: var(--accent);
    font-weight: 500;
    text-decoration-color: currentcolor;
  }

  /* ── First task zone ─────────────────────────────────────────────────── */

  @media (min-width: 900px) {
    .outage .ask { display: block; }

    .outage .task-zone {
      display: grid;
      grid-template-columns: minmax(20rem, 0.8fr) minmax(0, 1.2fr);
      column-gap: clamp(24px, 3vw, 36px);
      row-gap: 24px;
      align-items: start;
    }

    .outage .verdict { margin: 0; }
    .outage .task-zone > .evidence {
      grid-column: 1 / -1;
      margin-top: 0;
    }
    .outage .task-zone > .evidence ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 32px;
    }
    .outage .task-zone > .evidence li { padding: 0; border-top: 0; }
    .outage .browse { max-width: 60rem; }
  }
  .outage .task-zone,
  .outage .browse,
  .outage .locator,
  .outage .verdict,
  .outage .evidence { min-width: 0; }

  @media (max-width: 559px) {
    .outage .types { gap: 4px 14px; }
    .outage .date-set { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .outage .browse-toggle { align-items: flex-start; flex-direction: column; gap: 2px; padding: 8px 0; }
    .outage .browse-preview { max-width: none; text-align: left; }
  }


  /* ── Phone ───────────────────────────────────────────────────────────── */

  @media (max-width: 680px) {
    .outage h1 { max-width: none; }
    /* One step shorter, still well past the 44px a thumb needs. */
    .outage .field { height: 52px; }

    .outage .row {
      grid-template-areas:
        'time state'
        'bar  bar'
        'body body';
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: auto auto auto;
      row-gap: 8px;
      column-gap: 16px;
      padding: 16px 0;
    }

    /* One line of clocks here, and at 15px per hour the bar becomes the row's main mark. */
    .outage .row-time { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; }
    .outage .row-clock { display: inline; }
    .outage .row-span,
    .outage .row-next { margin-top: 0; }
    .outage .row-bar { margin-top: 0; }
    .outage .row-state { padding-top: 0; }
    .outage .row-area { font-size: 16px; }
    /* Keep only the anchors of the 24-hour scale when it is this narrow. */
    .outage .rail-hour[data-edge='mid'] { display: none; }
  }

  /* Coarse pointers get real targets without changing the visual register. */
  @media (pointer: coarse) {
    .outage .check,
    .outage .txtbtn,
    .outage .chip,
    .outage .row-more,
    .outage .fn-day,
    .outage summary,
    .outage .why-body a { min-height: 44px; }

    .outage .chip { align-items: center; }
    .outage .why-body a { display: inline-flex; align-items: center; }
  }

  /* ── Motion ──────────────────────────────────────────────────────────── */

  /* One authored moment, and only when the answer itself changed: never on a countdown
     tick, never per keystroke, never on the now marks, never on a row showing or hiding. */
  @media (prefers-reduced-motion: no-preference) {
    .outage .verdict[data-fresh] .verdict-body > * {
      animation: verdict-in 180ms cubic-bezier(0.2, 0, 0, 1) both;
    }

    .outage .verdict[data-fresh] .verdict-detail,
    .outage .verdict[data-fresh] .verdict-confidence { animation-delay: 40ms; }
  }

  @keyframes verdict-in {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }
</style>

<script>
  import { entryStatus, manilaDate } from '../scripts/outages.mjs';
  import {
    badgeFor,
    conciseAnnouncement,
    citiesOf,
    cityRows,
    clock,
    dayFull,
    dayKey,
    dayOffset,
    dayShort,
    interruptionType,
    isVisible,
    previewArea,
    splitArea,
    squeeze,
    sourceStatusForDisplay,
    verdictView,
    windowDays,
  } from '../scripts/power-view.mjs';
  import { lookupPlace } from '../scripts/franchise.mjs';

  type Entry = {
    kind: 'scheduled' | 'emergency' | 'rotational';
    start: string;
    end: string;
    hours: number;
    flag: string | null;
    area: string;
    streets: string;
    areasRaw: string;
    purpose: string;
    source: string;
    sourceTitle?: string;
    sourceStatus?: string;
    category?: string;
    type?: string;
    map?: string;
    possible?: boolean;
    postedAt?: string | null;
  };

  type Ingest = {
    checkedAt: string | null;
    latestPostAt: string | null;
    result?: string | null;
  };
  type Calendar = { available: boolean; checkedAt: string | null; count: number; skipped: number };
  /** The API's own span, which the fortnight rule draws even where no advisory landed. */
  type FeedWindow = { from: string; to: string; today?: string };
  type FyiActual = {
    coverage: 'per-feeder' | 'aggregate';
    state: 'partial' | 'all-off' | 'restored' | 'open-stale' | 'aggregate' | 'unknown';
    startedAt: string | null;
    endedAt: string | null;
    ongoing: boolean;
    stale: boolean;
    recorded: number | null;
    total: number | null;
    mw: number | null;
  };
  type FyiWindow = {
    start: string;
    end: string;
    hours: number;
    feederCount: number;
    actual: FyiActual | null;
  };
  type FyiPlan = { id: string; date: string; windows: FyiWindow[] };
  type FyiAdvisory = { id: string; type: string; start: string; end: string; status: 'published' | 'cancelled' };
  type Fyi = {
    available: boolean;
    checkedAt: string | null;
    sourceStamp: string | null;
    freshness: 'fresh' | 'stale' | 'unknown';
    sourceUrl: 'https://fyi.aboitizpower.com/';
    plans: FyiPlan[];
    advisories: FyiAdvisory[];
    warnings: string[];
  };

  type Feed = {
    updated: string;
    window?: FeedWindow;
    entries?: Entry[];
    posts?: { title: string }[];
    ingest?: Ingest;
    calendar?: Calendar;
    warnings?: string[];
    fyi?: Fyi;
  };

  type SourceReadability = 'readable' | 'partial' | 'unreadable';

  /** A verdict line: stable prose, plus the one countdown that moves every minute. */
  type Segment = string | { count: string };

  const el = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;

  const form = el<HTMLFormElement>('[data-form]');
  const search = el<HTMLInputElement>('[data-search]');
  const clearInput = el<HTMLButtonElement>('[data-clear-input]');
  const hint = el('[data-hint]');
  const locateBtn = el<HTMLButtonElement>('[data-locate]');
  const verdict = el('[data-verdict]');
  const verdictMark = el('[data-verdict-mark]');
  const verdictHead = el('[data-verdict-head]');
  const verdictDetail = el('[data-verdict-detail]');
  const confidence = el('[data-confidence]');
  const verdictMeta = el('[data-verdict-meta]');
  const verdictActions = el('[data-verdict-actions]');
  const resetBtn = el<HTMLButtonElement>('[data-reset]');
  const retryBtn = el<HTMLButtonElement>('[data-retry]');
  const answerAnnouncement = el('[data-answer-announcement]');
  const answerSources = el('[data-answer-sources]');
  const fyiStatus = el('[data-fyi-status]');
  const fyiStatusCopy = el('[data-fyi-status-copy]');
  const rotationalContext = el('[data-rotational-context]');
  const cityPrompt = el('[data-city-prompt]');
  const evidence = el('[data-evidence]');
  const browse = el<HTMLDetailsElement>('[data-browse]');
  const browsePreview = el('[data-browse-preview]');
  const citiesBox = el('[data-cities]');
  const chipBox = el('[data-chips]');
  const typeInputs = [...document.querySelectorAll<HTMLInputElement>('[data-type]')];
  const showFinished = el<HTMLInputElement>('[data-show-finished]');
  const feed = el('[data-feed]');
  const emptyNote = el('[data-empty]');
  const emptyLine = el('[data-empty-line]');
  const emptyFeed = el('[data-empty-feed]');
  const emptyFeedLine = el('[data-empty-feed-line]');
  const clearBtn = el<HTMLButtonElement>('[data-clear]');
  const toolbar = el('[data-toolbar]');
  const toolbarNote = el('[data-toolbar-note]');
  const rangeHead = el('[data-range]');
  const fortnight = el('[data-fortnight]');
  const updated = el('[data-updated]');

  const FYI_SOURCE_URL = 'https://fyi.aboitizpower.com/' as const;

  // Three missed 15-minute poller cycles. Judged against the feed's own timestamp, not
  // Date.now(), so a tab left open overnight does not invent a staleness warning.
  const INGEST_STALE_MS = 45 * 60 * 1000;
  // How old the payload itself may get before the minute tick re-reads it. A tab left
  // open during an outage is the normal case, and ageing the badges it loaded with is
  // not the same as following the schedule.
  const REFETCH_MS = 5 * 60 * 1000;
  // Streets longer than this get a toggle. A string length, never a measured height: the
  // layout probe is what made content-visibility unsafe on rows.
  const STREETS_CLAMP = 90;

  const stampFmt = new Intl.DateTimeFormat('en-PH', {
    timeZone: 'Asia/Manila',
    dateStyle: 'medium',
    timeStyle: 'short',
  });
  const dateShort = new Intl.DateTimeFormat('en-PH', { timeZone: 'Asia/Manila', day: 'numeric', month: 'short' });
  const monthDay = new Intl.DateTimeFormat('en-PH', { timeZone: 'Asia/Manila', month: 'long', day: 'numeric' });

  let entries: Entry[] = [];
  let byKey = new Map<string, Entry>();
  let feedWindow: FeedWindow | undefined;
  let city = '';
  let selectedDay = '';
  let appliedArea = '';
  let detected = '';
  let ingest: Ingest | undefined;
  let calendar: Calendar | undefined;
  let warnings: string[] = [];
  let fyi: Fyi = fyiUnavailable();
  let sourceReadability: SourceReadability = 'unreadable';
  let refreshFailed = false;
  let fetchedAt = Date.now();
  let lastFetch = 0;
  let feedSig = '';
  let evidenceDataSig = '';
  let chipSig = '';
  let fortnightSig = '';
  // Which Cebu day the list was built for: past midnight, in-place patching cannot fix it.
  let renderedToday = '';
  let loading = false;
  let forceAnswerAnnouncement = false;
  let lastAnnouncementIdentity = '';
  let lastAnnouncementSource = 'loading';
  let announcementFrame = 0;
  let cityPromptSig = '';
  let pendingDayJump = '';
  let archiveOpen = false;
  let moreDatesOpen = false;
  // Which chrome the page is showing. A failed feed must not also be blamed on Facebook's
  // supplementary poller.
  let chrome: 'loading' | 'ok' | 'failed' = 'loading';

  const esc = (value: string) =>
    value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));

  // One entry, one identity — shared by its row, its rail block and the minute tick.
  const keyOf = (entry: Entry) => `${entry.start}|${entry.area}`;

  // A needle of pure punctuation folds away to nothing, so it must read as no query at all:
  // otherwise the label, `scoped` and the matcher disagree and the page answers "Yes, power
  // is out now in ." over all 400 rows. `appliedArea` changes only when the reader commits
  // the field, so typing never churns the answer or the live announcement.
  const query = () => (squeeze(appliedArea) ? appliedArea.trim().toLowerCase() : '');

  /** What the roster makes of the typed name, so the answer can say "not our franchise". */
  type Place = {
    kind: 'city' | 'barangay' | 'outside';
    place: string;
    lgus: readonly string[];
    utility?: string;
  };

  // A typed place and a selected city compose. If their known franchise locations conflict,
  // preserve that uncertainty instead of answering an all-clear for a place excluded by city.
  const placeOf = () => {
    const typed = query() ? (lookupPlace(appliedArea) as Place | null) : null;
    if (typed) {
      if (city && typed.kind !== 'outside' && typed.lgus.length && !typed.lgus.includes(city)) return null;
      return typed;
    }
    const byCity = city ? (lookupPlace(city) as Place | null) : null;
    return byCity?.kind === 'outside' ? byCity : null;
  };

  const verdictLabel = () => {
    const typed = query() ? appliedArea.trim().replace(/\b\p{Ll}/gu, (c) => c.toUpperCase()) : '';
    return typed && city ? `${typed} in ${city}` : typed || city;
  };

  const selectedTypes = () => typeInputs.filter((input) => input.checked).map((input) => input.dataset.type!);

  /** The answer ignores browse-only type, date, and history filters so those controls cannot make a local all-clear. */
  const verdictScope = (now = Date.now()) =>
    entries.filter((entry) => isVisible(entry, { city, needle: query(), hideDone: false, now }));

  const filtered = (opts: { includeDone?: boolean; now?: number } = {}) => {
    const needle = query();
    const now = opts.now ?? Date.now();
    const hideDone = !opts.includeDone && !showFinished.checked;
    const types = selectedTypes();
    return entries.filter((entry) =>
      isVisible(entry, { city, needle, types, hideDone, now }) &&
      (!selectedDay || dayKey(entry.start) === selectedDay));
  };

  // An HTTP response only proves the endpoint ran. The schedule is readable when its
  // metadata proves that the official calendar, an advisory fallback, or usable entries
  // were actually read.
  const hasTimestamp = (value: string | null | undefined) => Number.isFinite(Date.parse(`${value || ''}`));
  const sourceReadabilityOf = (data: Feed): SourceReadability => {
    const calendarRead = data.calendar?.available === true;
    const advisoryRead = (data.posts?.length || 0) > 0 ||
      (hasTimestamp(data.ingest?.checkedAt) && data.ingest?.result !== 'error');
    const hasUsableEntries = (data.entries?.length || 0) > 0;
    if (!calendarRead && !advisoryRead && !hasUsableEntries) return 'unreadable';
    return calendarRead && !data.calendar?.skipped && !data.warnings?.length ? 'readable' : 'partial';
  };
  const ingestStale = () =>
    !hasTimestamp(ingest?.checkedAt) || fetchedAt - Date.parse(ingest!.checkedAt!) > INGEST_STALE_MS;
  const calendarAvailable = () => Boolean(calendar?.available);
  const calendarIncomplete = () => calendarAvailable() && (calendar?.skipped || 0) > 0;

  // Both callers branch on a parsed check time first, so this only ever formats a real
  // timestamp: "7:16 PM today" inside the Cebu day, the full date before it.
  const whenChecked = () => {
    const at = new Date(ingest!.checkedAt!);
    const sameDay = dayKey(ingest!.checkedAt!) === manilaDate(fetchedAt);
    return sameDay ? `${clock.format(at)} today` : `${dayFull.format(at)}, ${clock.format(at)}`;
  };

  const checkedTime = (iso: string | null | undefined) => {
    const at = Date.parse(`${iso}`);
    return Number.isFinite(at) ? clock.format(new Date(at)) : 'time unavailable';
  };

  const isPlainObject = (value: unknown): value is Record<string, unknown> =>
    Boolean(value) && typeof value === 'object' && !Array.isArray(value);
  const nullableString = (value: unknown) => typeof value === 'string' ? value : null;
  const nullableNumber = (value: unknown) => typeof value === 'number' && Number.isFinite(value) ? value : null;
  const fyiWarningsOf = (value: unknown) =>
    Array.isArray(value) ? value.filter((warning): warning is string => typeof warning === 'string') : [];

  function fyiActualOf(value: unknown): FyiActual | null {
    if (!isPlainObject(value)) return null;
    const coverage = value.coverage;
    const state = value.state;
    if (
      (coverage !== 'per-feeder' && coverage !== 'aggregate') ||
      !['partial', 'all-off', 'restored', 'open-stale', 'aggregate', 'unknown'].includes(`${state}`) ||
      typeof value.ongoing !== 'boolean' ||
      typeof value.stale !== 'boolean'
    ) return null;
    return {
      coverage,
      state: state as FyiActual['state'],
      startedAt: nullableString(value.startedAt),
      endedAt: nullableString(value.endedAt),
      ongoing: value.ongoing,
      stale: value.stale,
      recorded: nullableNumber(value.recorded),
      total: nullableNumber(value.total),
      mw: nullableNumber(value.mw),
    };
  }

  function fyiWindowOf(value: unknown): FyiWindow | null {
    if (!isPlainObject(value) || typeof value.start !== 'string' || typeof value.end !== 'string') return null;
    const actual = value.actual === null ? null : fyiActualOf(value.actual);
    if (value.actual !== null && !actual) return null;
    const hours = nullableNumber(value.hours);
    const feederCount = nullableNumber(value.feederCount);
    if (hours === null || feederCount === null) return null;
    return { start: value.start, end: value.end, hours, feederCount, actual };
  }

  function fyiPlanOf(value: unknown): FyiPlan | null {
    if (!isPlainObject(value) || typeof value.id !== 'string' || typeof value.date !== 'string' || !Array.isArray(value.windows)) return null;
    const windows = value.windows.map(fyiWindowOf);
    return windows.every((window): window is FyiWindow => window !== null)
      ? { id: value.id, date: value.date, windows }
      : null;
  }

  function fyiAdvisoryOf(value: unknown): FyiAdvisory | null {
    if (
      !isPlainObject(value) ||
      typeof value.id !== 'string' ||
      typeof value.type !== 'string' ||
      typeof value.start !== 'string' ||
      typeof value.end !== 'string' ||
      (value.status !== 'published' && value.status !== 'cancelled')
    ) return null;
    return { id: value.id, type: value.type, start: value.start, end: value.end, status: value.status };
  }

  function fyiUnavailable(warnings: string[] = []): Fyi {
    return {
      available: false,
      checkedAt: null,
      sourceStamp: null,
      freshness: 'unknown',
      sourceUrl: FYI_SOURCE_URL,
      plans: [],
      advisories: [],
      warnings,
    };
  }

  function fyiOf(data: Feed): Fyi {
    const raw = data.fyi;
    const warnings = fyiWarningsOf(raw?.warnings);
    if (
      !raw ||
      raw.available !== true ||
      !Array.isArray(raw.plans) ||
      !Array.isArray(raw.advisories) ||
      !['fresh', 'stale', 'unknown'].includes(raw.freshness)
    ) return fyiUnavailable(warnings);
    const plans = raw.plans.map(fyiPlanOf);
    const advisories = raw.advisories.map(fyiAdvisoryOf);
    if (plans.some((plan) => !plan) || advisories.some((advisory) => !advisory)) return fyiUnavailable(warnings);
    return {
      available: true,
      checkedAt: nullableString(raw.checkedAt),
      sourceStamp: nullableString(raw.sourceStamp),
      freshness: raw.freshness,
      sourceUrl: FYI_SOURCE_URL,
      plans: plans as FyiPlan[],
      advisories: advisories as FyiAdvisory[],
      warnings,
    };
  }

  function fyiRelevantWindow(now: number) {
    const candidates = fyi.plans
      .filter((plan) => plan.date === manilaDate(now))
      .flatMap((plan) => plan.windows.map((window) => ({ plan, window })))
      .filter(({ window }) => Number.isFinite(Date.parse(window.start)) && Number.isFinite(Date.parse(window.end)));
    return candidates.sort(({ window: a }, { window: b }) => {
      const aStart = Date.parse(a.start);
      const aEnd = Date.parse(a.end);
      const bStart = Date.parse(b.start);
      const bEnd = Date.parse(b.end);
      const aRank = a.actual?.ongoing || (aStart <= now && aEnd >= now) ? 0 : aStart > now ? 1 : 2;
      const bRank = b.actual?.ongoing || (bStart <= now && bEnd >= now) ? 0 : bStart > now ? 1 : 2;
      return aRank - bRank || (aRank === 2 ? bEnd - aEnd : aStart - bStart);
    })[0];
  }

  const fyiActualTime = (value: string | null) => {
    if (!hasTimestamp(value)) return null;
    const at = new Date(value!);
    return `${dayFull.format(at)}, ${clock.format(at)}`;
  };

  function fyiOperatorSummary(actual: FyiActual) {
    const startedAt = fyiActualTime(actual.startedAt);
    const endedAt = fyiActualTime(actual.endedAt);
    const timing = [
      startedAt ? `Earliest recorded-off time: ${startedAt}.` : '',
      endedAt ? `Recorded restoration time: ${endedAt}.` : '',
    ].filter(Boolean).join(' ');
    const count = actual.coverage === 'per-feeder' && actual.recorded !== null && actual.total !== null
      ? ` ${actual.recorded} of ${actual.total} feeder records recorded.`
      : '';

    let state: string;
    if (actual.coverage === 'aggregate') {
      state = actual.ongoing
        ? actual.stale
          ? 'aggregate records show ongoing activity, but at least one open record is stale; the complete current state is not confirmed'
          : 'aggregate records show ongoing activity'
        : actual.stale
          ? 'aggregate records have an open stale record; the current state is not confirmed'
          : actual.state === 'unknown'
            ? 'aggregate records have an unknown current state'
            : endedAt
              ? 'aggregate records show restoration'
              : 'aggregate records have no confirmed current state';
    } else {
      state = actual.ongoing
        ? actual.state === 'all-off'
          ? 'per-feeder records show all recorded feeders are off and ongoing'
          : actual.stale
            ? 'per-feeder records show some feeders are off and ongoing, but at least one open record is stale; the complete current state is not confirmed'
            : 'per-feeder records show some feeders are off and ongoing'
        : actual.stale
          ? 'per-feeder records have an open stale record; the current state is not confirmed'
          : actual.state === 'restored'
            ? 'per-feeder records show restoration'
            : actual.state === 'unknown'
              ? 'per-feeder records have an unknown current state'
              : 'per-feeder records have no confirmed current state';
    }
    return `FYI operator record: ${state}.${count}${timing ? ` ${timing}` : ''}`;
  }

  const fyiPartialReadText = () =>
    fyi.warnings.length ? ' FYI is only partly readable; current supplemental records may be missing.' : '';

  function fyiFreshnessText() {
    const checkedAt = fyiActualTime(fyi.checkedAt);
    const checked = checkedAt ? ` Accoworks checked FYI at ${checkedAt}, Cebu time.` : '';
    if (fyi.freshness === 'fresh') return ` FYI source update time is recent.${checked}`;
    if (fyi.freshness === 'stale') return ` FYI source data is stale.${checked}`;
    return checked
      ? ` FYI does not publish an update time.${checked}`
      : ' FYI does not publish an update time; the Accoworks check time is unavailable.';
  }

  function fyiStatusText(now: number) {
    const context = 'FYI publishes supplemental load-shedding plans and operator records; it is separate from the published calendar.';
    const partial = fyiPartialReadText();
    if (!fyi.available) return `${context}${partial} FYI is unavailable; the published Visayan Electric schedule is unchanged.`;
    const current = fyiRelevantWindow(now);
    const freshness = fyiFreshnessText();
    if (!current) {
      const date = monthDay.format(new Date(`${manilaDate(now)}T12:00:00+08:00`));
      return partial
        ? `${context}${partial} No readable FYI plan is available for ${date}.${freshness}`
        : `${context} No supplemental FYI plan is published for ${date}.${freshness}`;
    }
    const { plan, window } = current;
    const planned = `FYI plan: ${dayFull.format(new Date(`${plan.date}T12:00:00+08:00`))}, ${clock.format(new Date(window.start))} to ${clock.format(new Date(window.end))}, Cebu time — planned, not confirmed.`;
    const actual = window.actual
      ? ` ${fyiOperatorSummary(window.actual)} This is a supplemental operational record, not confirmation for this address.`
      : '';
    return `${context} ${planned}${actual}${freshness}${partial}`;
  }

  function renderFyiStatus(visible: boolean, now: number) {
    fyiStatus.hidden = !visible;
    if (!visible) return;
    const text = fyiStatusText(now);
    if (fyiStatusCopy.textContent !== text) fyiStatusCopy.textContent = text;
  }

  function renderConfidence() {
    const skipped = calendar?.skipped || 0;
    const warning = warnings[0] ? ` Source warning: ${warnings[0].replace(/\.$/, '')}.` : '';
    const text = chrome === 'loading'
      ? 'Checking the published schedule in Cebu time.'
      : chrome === 'failed' || sourceReadability === 'unreadable'
        ? 'Schedule unreadable — this is not an all-clear. Cebu time.'
        : refreshFailed
          ? 'Could not refresh. The last successful published schedule remains visible and may be outdated. Cebu time.'
          : calendarAvailable()
            ? `Official calendar checked ${checkedTime(calendar?.checkedAt)}, Cebu time.${skipped ? ` ${skipped} calendar ${skipped === 1 ? 'row is' : 'rows are'} unreadable; this answer may be incomplete.` : ''}${warning}`
            : ingestStale()
              ? `Calendar unavailable; Facebook ${hasTimestamp(ingest?.checkedAt) ? `has not been checked since ${whenChecked()}` : 'has not been checked yet'}. Rotational updates may be missing; this is not an all-clear. Cebu time.${warning}`
              : `Calendar unavailable; Facebook checked ${checkedTime(ingest?.checkedAt)} for rotational updates. Cebu time.${warning}`;
    if (confidence.textContent !== text) confidence.textContent = text;
  }

  function sourceConfidenceKey() {
    if (chrome === 'loading') return 'loading';
    if (chrome === 'failed' || sourceReadability === 'unreadable') return 'unreadable';
    if (refreshFailed || (!calendarAvailable() && ingestStale())) return 'stale';
    if (sourceReadability === 'partial' || calendarIncomplete() || warnings.length) return 'partial';
    return calendarAvailable() ? 'calendar' : 'fallback';
  }

  function sourceConfidenceAnnouncement(previous: string, current: string) {
    const wasDegraded = previous === 'unreadable' || previous === 'stale' || previous === 'partial';
    const recovered = wasDegraded && (current === 'calendar' || current === 'fallback');
    if (recovered) return current === 'calendar'
      ? 'Published schedule recovered from the official calendar.'
      : 'Published schedule recovered, but calendar updates may still be incomplete.';
    if (current === 'unreadable') return 'Schedule unreadable. This is not an all-clear.';
    if (current === 'stale') return 'Could not refresh. The last published schedule may be outdated.';
    if (current === 'partial') return 'Published schedule may be incomplete.';
    if (current === 'fallback') return 'Calendar unavailable; rotational updates may be incomplete.';
    return 'Official calendar is available.';
  }
  const verdictStateOrder = (state: string) => state === 'live' ? 0 : state === 'upcoming' ? 1 : 2;

  function substantiveVerdictKey(view: { key: string }, scope: Entry[], now: number) {
    const windows = scope
      .map((entry) => ({ entry, state: entryStatus(entry, now).state }))
      .filter(({ state }) => state === 'live' || state === 'upcoming' || state === 'cancelled')
      .sort((a, b) =>
        verdictStateOrder(a.state) - verdictStateOrder(b.state) || Date.parse(a.entry.start) - Date.parse(b.entry.start))
      .slice(0, 2)
      .map(({ entry, state }) => `${entry.start}|${entry.end}|${entry.flag || ''}|${state}|${entry.possible ? 'possible' : 'confirmed'}`)
      .join(',');
    return `${view.key}|${windows}`;
  }

  function announcementWindowDetails(scope: Entry[], now: number) {
    return scope
      .map((entry) => ({ entry, state: entryStatus(entry, now).state }))
      .filter(({ state }) => state === 'live' || state === 'upcoming' || state === 'cancelled')
      .sort((a, b) =>
        verdictStateOrder(a.state) - verdictStateOrder(b.state) || Date.parse(a.entry.start) - Date.parse(b.entry.start))
      .slice(0, 2)
      .map(({ entry, state }) => {
        const status = state === 'cancelled'
          ? 'cancelled'
          : entry.flag || (entry.possible ? 'possible, not confirmed' : state === 'live' ? 'in progress' : 'scheduled');
        return `Published ${status}: ${dayFull.format(new Date(entry.start))}, ${clock.format(new Date(entry.start))} to ${clock.format(new Date(entry.end))}.`;
      });
  }

  function renderVerdictControls(scoped: boolean) {
    // Recovery belongs to a failed or partially unreadable schedule, not to a healthy answer.
    resetBtn.hidden = !scoped;
    retryBtn.hidden = chrome !== 'failed' && sourceReadability !== 'unreadable' && !refreshFailed && !calendarIncomplete();
    verdictActions.hidden = resetBtn.hidden && retryBtn.hidden;

    const location = detected ? `Located: ${detected}` : '';
    if (verdictMeta.textContent !== location) verdictMeta.textContent = location;
    verdictMeta.hidden = !location;
  }

  function renderAnswerSources(scope: Entry[], scoped: boolean, needsCity: boolean, now: number) {
    const visible = scoped && chrome !== 'loading' && !needsCity;
    answerSources.hidden = !visible;
    rotationalContext.hidden = !visible || !scope.some((entry) => entry.possible);
    renderFyiStatus(visible, now);
  }

  function renderCityPrompt(view: { needsCity: boolean; cityChoices: string[] }) {
    if (!view.needsCity) {
      cityPrompt.hidden = true;
      if (cityPromptSig || cityPrompt.textContent) cityPrompt.textContent = '';
      cityPromptSig = '';
      return;
    }
    const place = placeOf()?.place || verdictLabel();
    const applied = appliedArea.trim();
    const sig = `${applied}|${place}|${view.cityChoices.join('|')}`;
    if (sig === cityPromptSig) {
      cityPrompt.hidden = false;
      return;
    }
    const active = document.activeElement;
    const focusedCity = active instanceof HTMLElement && cityPrompt.contains(active)
      ? active.closest<HTMLButtonElement>('[data-city-choice]')?.dataset.cityChoice
      : '';
    cityPrompt.innerHTML =
      `<p>Select the city where you mean ${esc(place)}.</p><div class="city-choices">` +
      view.cityChoices.map((name) =>
        `<button type="button" data-city-choice="${esc(name)}" data-applied-area="${esc(applied)}" aria-label="Check ${esc(place)} in ${esc(name)}">${esc(name)}</button>`,
      ).join('') +
      '</div>';
    cityPromptSig = sig;
    cityPrompt.hidden = false;
    if (focusedCity) cityPrompt.querySelector<HTMLButtonElement>(`[data-city-choice="${CSS.escape(focusedCity)}"]`)?.focus();
  }

  function clearEvidence() {
    evidence.hidden = true;
    if (evidenceDataSig || evidence.textContent) evidence.textContent = '';
    evidenceDataSig = '';
  }

  function localProof(entry: Entry, place: Place | null) {
    const matched = place?.kind === 'barangay' ? place.place : verdictLabel();
    const lgu = city || (place?.lgus.length === 1 ? place.lgus[0] : citiesOf(entry).length === 1 ? citiesOf(entry)[0] : 'LGU not specified');
    const { shown } = splitArea(entry.area, Number.MAX_SAFE_INTEGER) as { shown: string };
    const all: string[] = shown
      .split(',')
      .map((part: string) => part.trim())
      .filter(Boolean);
    const match = squeeze(matched);
    const includesMatch = match && all.some((part: string) => squeeze(part).includes(match));
    return { matched, lgu, otherAreas: Math.max(0, all.length - (includesMatch ? 1 : 0)) };
  }

  function renderEvidence(scope: Entry[], now: number, scoped: boolean, needsCity: boolean) {
    if (!scoped || needsCity || chrome !== 'ok') {
      clearEvidence();
      return;
    }
    const order = (entry: Entry) => {
      const state = entryStatus(entry, now).state;
      if (state === 'live') return entry.possible ? 1 : 0;
      if (state === 'upcoming') return entry.possible ? 3 : 2;
      if (state === 'done') return 4;
      if (state === 'cancelled') return 5;
      return 6;
    };
    const rows = scope
      .slice()
      .sort((a, b) => order(a) - order(b) || Date.parse(a.start) - Date.parse(b.start))
      .slice(0, 2);
    if (!rows.length) {
      clearEvidence();
      return;
    }
    const today = manilaDate(now);
    const place = placeOf();
    const dataSig = `${sourceReadability}|${feedSig}|${today}|${query()}|${city}|${rows.map((entry) => `${keyOf(entry)}:${entryStatus(entry, now).state}`).join(',')}`;
    if (dataSig !== evidenceDataSig) {
      const html = `<p class="evidence-title">Matched published window${rows.length === 1 ? '' : 's'}</p><ol>${rows.map((entry) => {
        const state = entryStatus(entry, now).state;
        const from = timeOf(entry.start);
        const to = timeOf(entry.end);
        const start = Date.parse(entry.start);
        const end = Date.parse(entry.end);
        const date = Number.isFinite(start) ? dateShort.format(start) : 'Date not listed';
        const timing = from && to ? `${from} to ${to}${Number.isFinite(start) && Number.isFinite(end) && manilaDate(start) !== manilaDate(end) ? ' next day' : ''}` : 'Time not listed';
        const proof = localProof(entry, place);
        const officialScope = proof.otherAreas
          ? `<details class="evidence-scope"><summary>Show ${proof.otherAreas} other affected ${proof.otherAreas === 1 ? 'area' : 'areas'}</summary><p class="evidence-official">Official area: ${esc(entry.area)}</p></details>`
          : '';
        return `<li><p class="evidence-match">Matched: ${esc(proof.matched)} · ${esc(proof.lgu)} · ${esc(date)} · ${esc(timing)} · ${esc(stateWord(entry, state, dayKey(entry.start) === today))}</p>${officialScope}</li>`;
      }).join('')}</ol>`;
      evidence.innerHTML = html;
      evidenceDataSig = dataSig;
    }
    evidence.hidden = false;
  }

  // The short atomic announcer is separate from the visible proof. Applied answers and
  // concise location-recovery messages write here; countdown spans continue to age silently.
  // The compact announcer is intentionally assembled from durable published timing.
  // `conciseAnnouncement` removes each relative count so minute ticks cannot change it.

  function announceAtomic(message: string) {
    cancelAnimationFrame(announcementFrame);
    answerAnnouncement.textContent = '';
    announcementFrame = requestAnimationFrame(() => {
      answerAnnouncement.textContent = message;
    });
  }
  function paint(node: HTMLElement, segments: Segment[], rebuild: boolean) {
    if (rebuild) {
      node.textContent = '';
      for (const segment of segments) {
        if (typeof segment === 'string') {
          node.append(segment);
          continue;
        }
        const span = document.createElement('span');
        span.setAttribute('aria-live', 'off');
        span.textContent = segment.count;
        node.append(span);
      }
      return;
    }
    const spans = node.querySelectorAll<HTMLElement>('[aria-live="off"]');
    let index = 0;
    for (const segment of segments) {
      if (typeof segment === 'string') continue;
      const span = spans[index++];
      if (span && span.textContent !== segment.count) span.textContent = segment.count;
    }
  }

  function renderVerdict() {
    const now = Date.now();
    const scoped = Boolean(query() || city);
    const scope = verdictScope(now);
    const view = verdictView({
      entries,
      scope,
      // Echo the applied area back as a place name, not as raw keystrokes.
      label: verdictLabel(),
      scoped,
      city,
      stale: sourceReadability === 'partial' || refreshFailed,
      feed: chrome === 'failed' || sourceReadability === 'unreadable' ? 'failed' : chrome === 'ok' ? 'ready' : undefined,
      // Lets the answer tell "outside the franchise" apart from "nothing scheduled" and
      // from a name nobody recognises.
      place: placeOf(),
    }) as { tone: string; key: string; head: Segment[]; detail: Segment[]; needsCity: boolean; cityChoices: string[] };

    // The visual key includes stateful windows (start, end and cancellation) but never a
    // countdown. The announcement identity adds only coarse source confidence, never a
    // checked-at timestamp, so a real outage/source transition speaks once without minute churn.
    const substantiveKey = substantiveVerdictKey(view, scope, now);
    const sourceKey = sourceConfidenceKey();
    const announcementIdentity = `${substantiveKey}|source:${sourceKey}`;
    const sourceChanged = Boolean(lastAnnouncementSource && lastAnnouncementSource !== sourceKey);
    const identityChanged = Boolean(lastAnnouncementIdentity && lastAnnouncementIdentity !== announcementIdentity);
    const globalSourceTransition = !scoped && sourceChanged &&
      ['unreadable', 'stale', 'partial'].some((state) => state === lastAnnouncementSource || state === sourceKey);
    const announce = forceAnswerAnnouncement || (scoped && identityChanged) || globalSourceTransition;
    const previousSource = lastAnnouncementSource;
    forceAnswerAnnouncement = false;
    lastAnnouncementIdentity = announcementIdentity;
    lastAnnouncementSource = sourceKey;

    const changed = verdict.dataset.key !== substantiveKey;
    verdict.dataset.tone = view.tone;
    verdict.dataset.key = substantiveKey;
    // The tone is a 3px rule in the gutter; an idle answer has no tone to draw.
    verdictMark.hidden = view.tone === 'idle';
    paint(verdictHead, view.head, changed);
    paint(verdictDetail, view.detail, changed);
    renderAnswerSources(scope, scoped, view.needsCity, now);
    renderConfidence();
    renderVerdictControls(scoped);
    renderCityPrompt(view);
    renderEvidence(scope, now, scoped, view.needsCity);

    if (announce) {
      const detail = scoped && chrome !== 'failed' && sourceReadability !== 'unreadable'
        ? announcementWindowDetails(scope, now)
        : [];
      const sourceNote = sourceChanged ? ` ${sourceConfidenceAnnouncement(previousSource, sourceKey)}` : '';
      announceAtomic(`${conciseAnnouncement(view.head, detail)}${sourceNote}`);
    }
    if (!changed) return;

    // One authored moment: the answer settles in when it changes, never on a countdown
    // tick or while a reader types in the draft field.
    verdict.removeAttribute('data-fresh');
    void verdict.offsetWidth;
    verdict.setAttribute('data-fresh', '');
  }

  // City choices carry the query, date, type, and finished-history filters but stay
  // independent of the current city, so changing city always has a predictable visible set.
  // `chipSig` skips no-op minute ticks and preserves focused controls when the counts age.
  function renderChips(now = Date.now()) {
    if (!browse.open) return;
    const types = selectedTypes();
    const visible = entries.filter((entry) =>
      isVisible(entry, { needle: query(), types, hideDone: !showFinished.checked, now }) &&
      (!selectedDay || dayKey(entry.start) === selectedDay));
    const rows = [
      { name: 'All areas', value: '', count: visible.length },
      ...(cityRows(visible) as { name: string; count: number }[]).map((row) => ({
        name: row.name,
        value: row.name,
        count: row.count,
      })),
    ];
    // Without the label the accessible name reads "Mandaue96".
    const html = rows
      .map(({ name, value, count }) =>
        `<button type="button" class="chip" data-city="${esc(value)}" aria-pressed="${value === city}"${count ? '' : ' data-quiet'}` +
        ` aria-label="${esc(name)}, ${count ? `${count} schedule ${count === 1 ? 'entry' : 'entries'}` : 'nothing listed'}">` +
        `<span class="chip-tick" aria-hidden="true"></span><span class="chip-name">${esc(name)}</span>` +
        `<span class="chip-n" aria-hidden="true">${count || ''}</span></button>`)
      .join('');
    if (html === chipSig) return;
    const active = document.activeElement;
    const focusedCity = active instanceof HTMLElement && chipBox.contains(active)
      ? active.closest<HTMLButtonElement>('.chip')?.dataset.city
      : undefined;
    chipSig = html;
    chipBox.innerHTML = html;
    if (focusedCity === undefined) return;
    const replacement = chipBox.querySelector<HTMLButtonElement>(`.chip[data-city="${CSS.escape(focusedCity)}"]`);
    if (replacement) replacement.focus();
    else search.focus();
  }

  // Which cities the current search actually reaches: an attribute write outside the
  // chipSig string, so the needle never gets baked into the chip HTML.
  function paintCityHits(list: Entry[], needle: string) {
    const hit = new Set<string>();
    if (needle) for (const entry of list) for (const name of citiesOf(entry)) hit.add(name);
    for (const chip of chipBox.querySelectorAll<HTMLElement>('.chip[data-city]')) {
      const on = Boolean(chip.dataset.city) && hit.has(chip.dataset.city!);
      if (on === chip.hasAttribute('data-hit')) continue;
      if (on) chip.setAttribute('data-hit', '');
      else chip.removeAttribute('data-hit');
    }
  }

  // The hit is washed in place with the Custom Highlight API: one Range per match, no DOM
  // rewriting per keystroke. Read through a cast because the registry is newer than the
  // DOM types this project compiles against; absent (older Firefox) the wash never appears.
  type HitHighlight = { clear(): void; add(range: Range): void };
  const highlightCtor = (globalThis as unknown as { Highlight?: new () => HitHighlight }).Highlight;
  const highlightRegistry = (globalThis as unknown as {
    CSS?: { highlights?: { set(name: string, highlight: HitHighlight): void } };
  }).CSS?.highlights;
  const highlights = highlightCtor && highlightRegistry ? new highlightCtor() : null;
  if (highlights && highlightRegistry) highlightRegistry.set('hit', highlights);

  // Known ceiling: the wash needs offsets into the ORIGINAL text, and `squeeze` is not
  // length-preserving (NFD decomposition and dropped spaces both move offsets), so a row
  // matched only through folding ("Tag-bao" found by "tagbao") lists correctly but paints
  // nothing. Fixing it means an offset-preserving fold, which is more code than the wash
  // is worth; the row itself is still the answer.
  function paintHits(needle: string) {
    if (!highlights) return;
    highlights.clear();
    if (!needle) return;
    for (const holder of document.querySelectorAll<HTMLElement>('.outage .row-area, .outage .row-streets, .outage .evidence-match, .outage .evidence-official')) {
      for (let node = holder.firstChild; node; node = node.nextSibling) {
        if (node.nodeType !== 3) continue;
        const text = node.nodeValue || '';
        const hay = text.toLowerCase();
        let from = 0;
        let at = hay.indexOf(needle, from);
        while (at !== -1) {
          // toLowerCase() is not length-preserving everywhere, so an offset can land past
          // the node. A Range that would throw is skipped; the rest of the page still paints.
          if (at + needle.length <= text.length) {
            const range = document.createRange();
            range.setStart(node, at);
            range.setEnd(node, at + needle.length);
            highlights.add(range);
          }
          from = at + needle.length;
          at = hay.indexOf(needle, from);
        }
      }
    }
  }

  const RAIL_TICKS = [0, 6, 12, 18, 24]
    .map((hour) => {
      const pct = (hour / 24) * 100;
      const edge = hour === 0 ? 'start' : hour === 24 ? 'end' : 'mid';
      const label = hour === 0 ? '12 AM' : hour === 12 ? '12 NN' : hour === 24 ? '12 MN' : `${hour > 12 ? hour - 12 : hour} ${hour < 12 ? 'AM' : 'PM'}`;
      return `<span class="rail-tick" style="left:${pct}%"></span><span class="rail-hour" data-edge="${edge}" style="left:${pct}%">${label}</span>`;
    })
    .join('');

  const pct = (value: number) => `${Math.round(value * 100) / 100}%`;

  /** A clock, or nothing: Intl throws a RangeError on an unparseable date, and one bad
   *  advisory must not take the whole feed down with it. */
  const timeOf = (iso: string | null | undefined) => {
    const ms = Date.parse(`${iso}`);
    return Number.isFinite(ms) ? clock.format(ms) : '';
  };

  /** esc() stops HTML injection, not an executable scheme. These URLs come out of scraped
   *  advisory HTML and out of hand-typed KV text, so a link is only a link when it parses
   *  as http or https; anything else renders as no link at all. */
  const safeUrl = (value: string | null | undefined) => {
    try {
      const { protocol } = new URL(`${value}`);
      return protocol === 'http:' || protocol === 'https:' ? `${value}` : '';
    } catch {
      return '';
    }
  };

  /** Where a window sits on a day's 24 hours, or null when the entry's clocks did not parse. */
  function span(entry: Entry, key: string) {
    const from = dayOffset(entry.start, key);
    const to = dayOffset(entry.end, key);
    if (!Number.isFinite(from) || !Number.isFinite(to)) return null;
    return { left: (from / 1440) * 100, width: Math.max(((to - from) / 1440) * 100, 0.4) };
  }

  function rail(group: Entry[], key: string, now: number) {
    // Each block carries its row's key so the minute tick can age it in place.
    const blocks = group
      .map((entry) => {
        const at = span(entry, key);
        const state = entryStatus(entry, now).state;
        // A cancelled window is not a window: the count still names it, the rail does not.
        if (!at || state === 'cancelled' || state === 'unknown') return '';
        return `<span class="rail-block" data-key="${esc(keyOf(entry))}" data-state="${state}"${entry.possible ? ' data-possible' : ''}` +
          ` style="left:${pct(at.left)};width:${pct(at.width)}"></span>`;
      })
      .join('');

    const marker = key === manilaDate(now)
      ? `<span class="rail-now" style="left:${pct((dayOffset(new Date(now).toISOString(), key) / 1440) * 100)}"></span>`
      : '';

    return `<div class="rail" data-day="${esc(key)}" aria-hidden="true">${RAIL_TICKS}${blocks}${marker}</div>`;
  }

  const CHEVRON =
    '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5"/></svg>';

  // State is carried by the bar fill, this one word, and the live gutter rule. An entry
  // whose clocks did not parse still gets an honest word rather than a broken mark.
  function stateWord(entry: Entry, state: string, today: boolean) {
    if (state === 'cancelled') return 'Cancelled';
    if (state === 'unknown') return 'Time unclear';
    if (state === 'done') return entry.possible ? 'Window passed' : 'Finished';
    if (state === 'live') return entry.possible ? 'Possible now' : 'Out now';
    if (entry.possible) return 'Possible';
    return today ? 'Later today' : 'Scheduled';
  }

  // The countdown vocabulary stays in one place: badgeFor already says "1h 55m left" and
  // "in 2h". A possible window reports its window instead, because it may never happen.
  function stateSub(entry: Entry, state: string, now: number, today: boolean) {
    if (state === 'cancelled' || state === 'unknown') return '';
    if (state === 'done') return entry.possible ? 'possible only' : '';
    if (state === 'live') return entry.possible ? `until ${clock.format(new Date(entry.end))}` : badgeFor(entry, now);
    if (entry.possible) return 'if NGCP calls';
    // Off today, the day header already carries the day; a second "in 3 days" adds nothing.
    return today ? badgeFor(entry, now) : '';
  }

  /** The shared preview keeps the LGU context and any hidden query match visible. */
  function areaPreview(entry: Entry, needle: string) {
    const preview = previewArea(entry.area, needle);
    if (!preview.collapsed) return { ...preview, label: '' };
    const label = `Show ${preview.hidden} other affected ${preview.hidden === 1 ? 'area' : 'areas'}`;
    return { ...preview, label };
  }

  function areaControlLabel(preview: ReturnType<typeof areaPreview>, expanded: boolean) {
    return expanded ? 'Show fewer affected areas' : preview.label;
  }

  /** A text-built clamp keeps the LGU and query context visible without hiding semantics. */
  function areaCell(entry: Entry, needle: string) {
    const preview = areaPreview(entry, needle);
    if (!preview.collapsed) return esc(preview.text);
    const action = areaControlLabel(preview, false);
    return `${esc(preview.text)}<button type="button" class="row-more area-more" data-area-key="${esc(keyOf(entry))}" aria-expanded="false" aria-label="${esc(action)}">${esc(preview.label)}</button>`;
  }

  // A plain div, not an article: hundreds of repeated article boundaries are noise.
  // DOM order is time, status, then affected area; the visual grid keeps the same scan.
  function row(entry: Entry, key: string, now: number, today: string) {
    const state = entryStatus(entry, now).state;
    const isToday = key === today;
    const overnight = dayKey(entry.start) !== dayKey(entry.end);
    const at = span(entry, key);
    const sub = stateSub(entry, state, now, isToday);
    const from = timeOf(entry.start);
    const to = timeOf(entry.end);
    const posted = timeOf(entry.postedAt);
    const map = safeUrl(entry.map);
    const source = safeUrl(entry.source);
    const type = interruptionType(entry);
    const publishedStatus = sourceStatusForDisplay(entry.sourceStatus);
    const flag = `${entry.flag || ''}`.trim();
    const sourceChange = flag && flag !== 'cancelled' ? `Updated: ${flag}` : '';
    const sourceStatus = publishedStatus &&
      !/^(?:scheduled|emergency|rotational(?: brownout)?)$/i.test(publishedStatus) &&
      (!flag || !publishedStatus.toLowerCase().includes(flag.toLowerCase()))
      ? `Published status: ${publishedStatus}`
      : '';
    const tags = [
      entry.possible ? 'Possible rotational brownout' : type === 'emergency' ? 'Emergency interruption' : type === 'rotational' ? 'Rotational brownout' : '',
      sourceChange,
      sourceStatus,
    ].filter(Boolean).join(' · ');
    const hasEvidence = Boolean(entry.purpose || map || source || posted);
    const nowPct = isToday ? pct((dayOffset(new Date(now).toISOString(), key) / 1440) * 100) : '';

    return `
      <div class="row" data-state="${state}" data-key="${esc(keyOf(entry))}" data-when="${isToday ? 'today' : 'other'}"${entry.possible ? ' data-possible' : ''}>
        <div class="row-time">
          <p class="row-range">${from && to ? `<span class="row-clock">${from}</span> <span class="row-clock">to ${to}</span>` : '<span class="row-clock">Time not listed</span>'}</p>
          ${entry.hours ? `<p class="row-span">${entry.hours}h</p>` : ''}
          ${overnight ? '<p class="row-next">ends the next morning</p>' : ''}
        </div>
        <div class="row-state">
          <span class="row-word">${esc(stateWord(entry, state, isToday))}</span>
          ${sub ? `<span class="row-sub" aria-live="off">${esc(sub)}</span>` : ''}
        </div>
        <div class="row-bar ticks" aria-hidden="true">
          ${at ? `<span class="row-seg" style="left:${pct(at.left)};width:${pct(at.width)}"></span>` : ''}
          ${isToday ? `<span class="row-now" style="left:${nowPct}"></span>` : ''}
        </div>
        <div class="row-body">
          <p class="row-area">${areaCell(entry, query())}</p>
          ${entry.streets ? `<p class="row-streets">Along ${esc(entry.streets)}</p>` : ''}
          ${entry.streets && entry.streets.length > STREETS_CLAMP ? '<button type="button" class="row-more row-streets-more" aria-expanded="false">show all streets</button>' : ''}
          ${tags ? `<p class="row-tags">${esc(tags)}</p>` : ''}
          ${hasEvidence ? `<details><summary>${CHEVRON}Advisory details</summary><div class="why-body">${entry.purpose ? `<p>${esc(entry.purpose)}</p>` : ''}${map ? `<p><a href="${esc(map)}" rel="noopener" target="_blank">See the affected-area map</a></p>` : ''}${source ? `<p><a href="${esc(source)}" rel="noopener" target="_blank">${esc(entry.sourceTitle || 'Read the advisory')}</a></p>` : ''}${posted ? `<p>Posted by Visayan Electric ${posted}</p>` : ''}</div></details>` : ''}
        </div>
      </div>`;
  }

  const nowLabel = (now: number) => `Now ${clock.format(new Date(now))}`;

  const nowLineHtml = (now: number) =>
    `<div class="now-line" role="separator" aria-label="${esc(nowLabel(now))}"><span>${esc(nowLabel(now))}</span></div>`;

  /** The first row of a day that has not started yet: where the now line belongs. */
  const nowAnchor = (group: Entry[], now: number) => group.findIndex((entry) => Date.parse(entry.start) > now);

  function paintEmpty() {
    const place = appliedArea.trim() || city;
    const hasScope = Boolean(place);
    const outside = placeOf();
    const now = Date.now();
    const types = selectedTypes();
    const scopedEntries = entries.filter((entry) =>
      isVisible(entry, { city, needle: query(), hideDone: false, now }));
    const dateEntries = selectedDay
      ? scopedEntries.filter((entry) => dayKey(entry.start) === selectedDay)
      : scopedEntries;
    const matching = dateEntries.filter((entry) =>
      isVisible(entry, { city, needle: query(), types, hideDone: false, now }));
    const finished = matching.filter((entry) => entryStatus(entry, now).state === 'done');
    const noTypes = types.length === 0;
    const dayFilteredOut = Boolean(selectedDay) && scopedEntries.length > 0 && dateEntries.length === 0;
    const typeFilteredOut = !noTypes && types.length < typeInputs.length && dateEntries.length > 0 && matching.length === 0;
    const showHistory = outside?.kind !== 'outside' &&
      !noTypes && !showFinished.checked && matching.length === finished.length && finished.length > 0;
    const sentence = outside?.kind === 'outside'
      ? `${outside.place} is served by ${outside.utility}, not Visayan Electric, so no advisory for it reaches this page.`
      : noTypes
        ? 'No interruption types are selected.'
        : showHistory
          ? `No current or upcoming interruptions${place ? ` for ${place}` : ''}. ${finished.length} finished schedule ${finished.length === 1 ? 'entry is' : 'entries are'} not included.`
          : typeFilteredOut
            ? `No selected interruption types are listed${place ? ` for ${place}` : ''}.`
            : selectedDay
              ? `Nothing matches ${monthDay.format(new Date(`${selectedDay}T12:00:00+08:00`))}${place ? ` for ${place}` : ''}.`
              : place
                ? `Nothing matches the published filters for ${place}.`
                : 'Nothing matches the published filters.';
    if (emptyLine.textContent !== sentence) emptyLine.textContent = sentence;
    delete clearBtn.dataset.revealFinished;
    delete clearBtn.dataset.clearDay;
    delete clearBtn.dataset.resetTypes;
    delete clearBtn.dataset.resetScope;
    clearBtn.hidden = false;
    if (showHistory) {
      clearBtn.textContent = `Include ${finished.length} finished schedule ${finished.length === 1 ? 'entry' : 'entries'}`;
      clearBtn.dataset.revealFinished = 'true';
    } else if (noTypes || typeFilteredOut) {
      clearBtn.textContent = 'Show all interruption types';
      clearBtn.dataset.resetTypes = 'true';
    } else if (dayFilteredOut) {
      clearBtn.textContent = 'Show all published days';
      clearBtn.dataset.clearDay = 'true';
    } else if (hasScope) {
      clearBtn.textContent = 'Browse all interruptions';
      clearBtn.dataset.resetScope = 'true';
    } else {
      clearBtn.hidden = true;
    }
  }

  /** Every day the API published, so a quiet day still gets its tick. */
  function windowKeys(): string[] {
    if (feedWindow?.from && feedWindow?.to) return windowDays(feedWindow.from, feedWindow.to) as string[];
    if (!entries.length) return [];
    const keys = entries.map((entry) => dayKey(entry.start)).sort();
    return windowDays(keys[0], keys[keys.length - 1]) as string[];
  }

  /** Per-day counts for the supplied composed scope. */
  function dayTotals(list: Entry[] = entries) {
    const totals = new Map<string, number>();
    for (const entry of list) {
      const key = dayKey(entry.start);
      totals.set(key, (totals.get(key) || 0) + 1);
    }
    return totals;
  }

  // Every published day remains reachable, but the first pass is a readable set of four
  // near-term controls rather than a wall of narrow ticks.
  function paintFortnight(now: number) {
    const types = selectedTypes();
    const visible = entries.filter((entry) =>
      isVisible(entry, { city, needle: query(), types, hideDone: !showFinished.checked, now }));
    const totals = dayTotals(visible);
    const lit = new Set<string>();
    for (const entry of visible) {
      if (!entry.possible && entryStatus(entry, now).state === 'live') lit.add(dayKey(entry.start));
    }
    for (const button of fortnight.querySelectorAll<HTMLButtonElement>('.fn-day[data-key]')) {
      const key = button.dataset.key!;
      const count = totals.get(key) || 0;
      const numeral = button.querySelector<HTMLElement>('.fn-count')!;
      const text = count ? `${count}` : '—';
      if (numeral.textContent !== text) numeral.textContent = text;
      const selected = key === selectedDay;
      if (button.getAttribute('aria-pressed') !== String(selected)) button.setAttribute('aria-pressed', String(selected));
      const live = lit.has(key);
      if (live !== button.hasAttribute('data-live')) {
        if (live) button.setAttribute('data-live', '');
        else button.removeAttribute('data-live');
      }
      const noon = new Date(`${key}T12:00:00+08:00`);
      const label = `${dayShort.format(noon)} ${monthDay.format(noon)}, ${count ? `${count} ${count === 1 ? 'interruption' : 'interruptions'}` : 'nothing listed'}${selected ? ', selected' : ''}`;
      if (button.getAttribute('aria-label') !== label) button.setAttribute('aria-label', label);
    }
  }

  function dateButton(key: string, today: string) {
    const noon = new Date(`${key}T12:00:00+08:00`);
    const flag = key === today ? ' data-today' : key < today ? ' data-past' : '';
    return `<button type="button" class="fn-day" data-key="${esc(key)}"${flag}>` +
      `<span class="fn-weekday" aria-hidden="true">${esc(dayShort.format(noon).slice(0, 3))}</span>` +
      `<span class="fn-date" aria-hidden="true">${esc(dateShort.format(noon))}</span>` +
      '<span class="fn-count" aria-hidden="true">—</span></button>';
  }

  function renderFortnight(now: number, today: string) {
    const days = windowKeys();
    const nearTerm = days.filter((key) => key >= today).slice(0, 4);
    const primary = nearTerm.length ? nearTerm : days.slice(0, 4);
    const later = days.filter((key) => !primary.includes(key));
    const sig = `${today}|${primary.join(',')}|${later.join(',')}`;
    if (sig !== fortnightSig) {
      fortnightSig = sig;
      fortnight.innerHTML =
        `<div class="date-set">${primary.map((key) => dateButton(key, today)).join('')}</div>` +
        (later.length
          ? `<details class="more-dates" data-more-dates${moreDatesOpen || later.includes(selectedDay) ? ' open' : ''}>` +
            `<summary>Show ${later.length} more published ${later.length === 1 ? 'date' : 'dates'}</summary>` +
            `<div class="date-set">${later.map((key) => dateButton(key, today)).join('')}</div></details>`
          : '');
    }
    const more = fortnight.querySelector<HTMLDetailsElement>('[data-more-dates]');
    if (more && selectedDay && later.includes(selectedDay)) more.open = true;
    paintFortnight(now);
  }

  function renderFeed() {
    if (!browse.open) return;
    if (chrome !== 'ok') {
      feed.innerHTML = '';
      emptyNote.hidden = true;
      emptyFeed.hidden = true;
      return;
    }
    const list = filtered();
    const now = Date.now();
    const today = manilaDate(now);
    const needle = query();
    renderedToday = today;

    const groups = new Map<string, Entry[]>();
    for (const entry of list) {
      const key = dayKey(entry.start);
      const bucket = groups.get(key);
      if (bucket) bucket.push(entry);
      else groups.set(key, [entry]);
    }
    // Totals over everything published, so a filtered day can say "3 of 11" honestly.
    const totals = dayTotals();

    const feedEmpty = entries.length === 0;
    emptyFeed.hidden = !feedEmpty;
    if (feedEmpty) {
      const window = feedWindow?.from && feedWindow?.to
        ? `${monthDay.format(new Date(`${feedWindow.from}T12:00:00+08:00`))} to ${monthDay.format(new Date(`${feedWindow.to}T12:00:00+08:00`))}`
        : 'this published window';
      emptyFeedLine.textContent = `No interruptions are listed for ${window}. Check the official calendar for the next published update.`;
    }
    emptyNote.hidden = groups.size > 0 || feedEmpty;
    if (!emptyNote.hidden) paintEmpty();

    const renderDay = ([key, group]: [string, Entry[]]) => {
      const noon = new Date(`${key}T12:00:00+08:00`);
      const offset = Math.round(
        (Date.parse(`${key}T00:00:00+08:00`) - Date.parse(`${today}T00:00:00+08:00`)) / 86400000,
      );
      const rel = offset === 0 ? 'Today' : offset === 1 ? 'Tomorrow' : offset === -1 ? 'Yesterday' : dayShort.format(noon);
      const total = totals.get(key) || group.length;
      const count = group.length === total
        ? `${group.length} ${group.length === 1 ? 'interruption' : 'interruptions'}`
        : `${group.length} of ${total}`;
      // Exactly one now line on the page: inside today, between the last window that has
      // started and the first that has not, or closing the section when none is left.
      const anchor = key === today ? nowAnchor(group, now) : -1;
      const rows = group
        .map((entry, index) => `${index === anchor ? nowLineHtml(now) : ''}${row(entry, key, now, today)}`)
        .join('');
      return `
        <section class="day" id="day-${esc(key)}" data-day="${esc(key)}" tabindex="-1" aria-labelledby="day-label-${esc(key)}">
          <div class="day-head">
            <h2 class="day-name" id="day-label-${esc(key)}"><span class="day-rel"${offset === 0 ? ' data-today' : ''}>${esc(rel)}</span><span class="day-date">${esc(dateShort.format(noon))}</span></h2>
            <span class="day-count">${count}</span>
          </div>
          ${rail(group, key, now)}
          ${rows}${key === today && anchor === -1 ? nowLineHtml(now) : ''}
        </section>`;
    };

    const ordered = [...groups.entries()].sort((a, b) => a[0].localeCompare(b[0]));
    const primary = selectedDay
      ? ordered
      : (ordered.filter(([key]) => key >= today).length ? ordered.filter(([key]) => key >= today) : ordered).slice(0, 2);
    const later = selectedDay ? [] : ordered.filter(([key]) => !primary.some(([primaryKey]) => primaryKey === key));
    feed.innerHTML =
      primary.map(renderDay).join('') +
      (later.length
        ? `<details class="archive-more" data-archive-more${archiveOpen ? ' open' : ''}>` +
          `<summary>Show ${later.length} later published ${later.length === 1 ? 'day' : 'days'}</summary>` +
          later.map(renderDay).join('') +
          '</details>'
        : '');

    renderFortnight(now, today);
    paintCityHits(list, needle);
    paintHits(needle);

    if (pendingDayJump) {
      const targetKey = pendingDayJump;
      pendingDayJump = '';
      requestAnimationFrame(() => {
        const target = feed.querySelector<HTMLElement>(`#day-${CSS.escape(targetKey)}`);
        if (!target) return;
        target.scrollIntoView({ block: 'start' });
        target.focus({ preventScroll: true });
      });
    }
  }

  function renderSchedulePreview(now = Date.now()) {
    const today = manilaDate(now);
    const todayRows = entries.filter((entry) => dayKey(entry.start) === today).length;
    const current = entries.filter((entry) => {
      const state = entryStatus(entry, now).state;
      return state === 'live' || state === 'upcoming';
    }).length;
    const text = chrome === 'loading'
      ? 'Loading the published schedule…'
      : chrome === 'failed' || sourceReadability === 'unreadable'
        ? 'Published schedule unavailable — check the official calendar.'
        : `Today: ${todayRows ? `${todayRows} ${todayRows === 1 ? 'published interruption' : 'published interruptions'}` : 'no published interruptions'} · ${current ? `${current} current or upcoming` : 'none current or upcoming'}`;
    if (browsePreview.textContent !== text) browsePreview.textContent = text;
  }

  function renderBrowse() {
    if (!browse.open) return;
    toolbarNote.hidden = chrome !== 'ok' || !selectedTypes().includes('rotational');
    renderChips();
    renderFeed();
  }

  function render() {
    renderVerdict();
    renderSchedulePreview();
    renderBrowse();
  }

  // The now line is the page-scale cursor, so the minute tick has to move it rather than
  // let it drift: same node, same label, one insertBefore when its anchor row changes.
  function ageNowLine(now: number, today: string) {
    const section = feed.querySelector<HTMLElement>(`.day[data-day="${today}"]`);
    let line = feed.querySelector<HTMLElement>('.now-line');
    const rows = section ? [...section.querySelectorAll<HTMLElement>('.row[data-key]')] : [];
    if (!section || !rows.length) {
      line?.remove();
      return;
    }
    if (!line) {
      line = document.createElement('div');
      line.className = 'now-line';
      line.setAttribute('role', 'separator');
      line.append(document.createElement('span'));
    }
    const label = nowLabel(now);
    if (line.getAttribute('aria-label') !== label) {
      line.setAttribute('aria-label', label);
      line.firstElementChild!.textContent = label;
    }
    const anchor = rows.find((node) => {
      const entry = byKey.get(node.dataset.key || '');
      return Boolean(entry) && Date.parse(entry!.start) > now;
    }) || null;
    // Only move it when the anchor actually changed, or every tick costs two mutations.
    if (line.parentNode === section && line.nextElementSibling === anchor) return;
    if (anchor) section.insertBefore(line, anchor);
    else section.append(line);
  }

  // The minute tick only ages statuses. Patching the rows in place keeps open "Why"
  // panels open and keyboard focus where the user left it; a full rebuild would not.
  function refresh() {
    const now = Date.now();
    const today = manilaDate(now);
    renderVerdict();
    renderSchedulePreview(now);
    if (!browse.open) return;
    const needle = query();
    const list = filtered({ now });
    renderChips(now);
    paintCityHits(list, needle);
    // Past midnight every relative word, every "today" marker and the now line belong to
    // a different day, and no amount of in-place patching can fix that.
    if (renderedToday && renderedToday !== today) {
      renderFeed();
      return;
    }

    for (const node of feed.querySelectorAll<HTMLElement>('.row[data-key]')) {
      const entry = byKey.get(node.dataset.key || '');
      if (!entry) continue;
      const state = entryStatus(entry, now).state;
      const isToday = node.dataset.when === 'today';
      if (node.dataset.state !== state) node.dataset.state = state;

      const word = node.querySelector<HTMLElement>('.row-word');
      const label = stateWord(entry, state, isToday);
      if (word && word.textContent !== label) word.textContent = label;

      // The countdown moves every minute, so it lives in a node that does not announce.
      const text = stateSub(entry, state, now, isToday);
      let sub = node.querySelector<HTMLElement>('.row-sub');
      if (text && !sub) {
        sub = document.createElement('span');
        sub.className = 'row-sub';
        sub.setAttribute('aria-live', 'off');
        node.querySelector('.row-state')?.append(sub);
      }
      if (sub) {
        if (!text) sub.remove();
        else if (sub.textContent !== text) sub.textContent = text;
      }

      // The bar's own cursor, on today's rows only.
      if (isToday) {
        const tick = node.querySelector<HTMLElement>('.row-now');
        if (tick) tick.style.left = pct((dayOffset(new Date(now).toISOString(), today) / 1440) * 100);
      }
    }

    // The rail is drawn once per render, so its blocks age here too — otherwise a window
    // that just went live keeps the fill it was painted with while its row turns red.
    for (const block of feed.querySelectorAll<HTMLElement>('.rail-block[data-key]')) {
      const entry = byKey.get(block.dataset.key || '');
      if (!entry) continue;
      const state = entryStatus(entry, now).state;
      if (block.dataset.state !== state) block.dataset.state = state;
    }

    for (const railNode of feed.querySelectorAll<HTMLElement>('.rail[data-day]')) {
      const marker = railNode.querySelector<HTMLElement>('.rail-now');
      if (marker) marker.style.left = pct((dayOffset(new Date(now).toISOString(), railNode.dataset.day!) / 1440) * 100);
    }

    // The fortnight's live numerals age with everything else: a tab open across a start
    // must not keep a red row above an ink numeral.
    paintFortnight(now);

    ageNowLine(now, today);
  }

  function setHint(message: string, tone: 'neutral' | 'error' = 'neutral') {
    hint.textContent = message;
    hint.dataset.tone = tone;
  }

  async function locate() {
    if (!navigator.geolocation) {
      const message = 'This browser cannot share a location. Type your barangay instead.';
      setHint(message, 'error');
      announceAtomic(message);
      return;
    }
    locateBtn.setAttribute('aria-busy', 'true');
    locateBtn.disabled = true;
    setHint('Asking your browser for a location…');

    try {
      const position = await new Promise<GeolocationPosition>((resolve, reject) => {
        navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 12000, maximumAge: 300000 });
      });
      const { latitude, longitude } = position.coords;
      const response = await fetch(`/api/where?lat=${latitude.toFixed(5)}&lon=${longitude.toFixed(5)}`);
      const place = await response.json();
      if (!response.ok) throw new Error(place.error || 'lookup failed');

      const area = `${place.barangay || place.city || ''}`.trim();
      if (!area) throw new Error('location did not name an area');
      detected = place.label || area;
      search.value = area;
      appliedArea = area;
      city = '';
      forceAnswerAnnouncement = true;
      setHint(`Located ${detected}. Reviewing published interruptions for ${area}.`);
      render();
    } catch (error) {
      const denied = (error as GeolocationPositionError)?.code === 1;
      const message = denied
        ? 'Location permission was declined. Type your barangay instead.'
        : 'Could not work out your location. Type your barangay instead.';
      setHint(message, 'error');
      announceAtomic(message);
    } finally {
      locateBtn.removeAttribute('aria-busy');
      locateBtn.disabled = false;
    }
  }

  function applyCity(
    nextCity: string,
    { applied = search.value.trim(), focusAnswer = false }: { applied?: string; focusAnswer?: boolean } = {},
  ) {
    // Browse chips intentionally apply the field's current draft. Prompt choices instead
    // pass their stored applied place, so a later draft cannot change what is confirmed.
    appliedArea = applied;
    if (applied !== search.value.trim()) search.value = applied;
    detected = '';
    city = nextCity === city ? '' : nextCity;
    forceAnswerAnnouncement = true;
    render();
    if (focusAnswer) requestAnimationFrame(() => verdictHead.focus({ preventScroll: true }));
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    appliedArea = search.value.trim();
    detected = '';
    forceAnswerAnnouncement = true;
    render();
    setHint(appliedArea ? 'Showing published interruptions for this scope.' : 'Type an area, then check the published schedule.');
  });

  locateBtn.addEventListener('click', locate);
  for (const input of typeInputs) {
    input.addEventListener('change', () => renderBrowse());
  }
  showFinished.addEventListener('change', () => renderBrowse());

  chipBox.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.chip');
    if (!button) return;
    applyCity(button.dataset.city || '');
    // renderChips() replaced the button that was just pressed; put focus back on it.
    chipBox.querySelector<HTMLButtonElement>(`[data-city="${CSS.escape(city)}"]`)?.focus();
  });

  cityPrompt.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-city-choice]');
    if (!button) return;
    applyCity(button.dataset.cityChoice || '', {
      applied: button.dataset.appliedArea || appliedArea,
      focusAnswer: true,
    });
  });

  // The long-area and long-street expanders. The area's full string is rebuilt from the
  // entry, so hundreds of rows never carry two copies of their barangay list in the markup.
  function toggleArea(button: HTMLButtonElement) {
    const entry = byKey.get(button.dataset.areaKey || '');
    const label = button.previousSibling;
    if (!entry || label?.nodeType !== Node.TEXT_NODE) return;
    const open = button.getAttribute('aria-expanded') !== 'true';
    const preview = areaPreview(entry, query());
    label.textContent = open ? entry.area : preview.text;
    button.setAttribute('aria-expanded', String(open));
    button.textContent = open ? 'show less' : preview.label;
    button.setAttribute('aria-label', areaControlLabel(preview, open));
    paintHits(query());
  }

  feed.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.row-more');
    if (!button) return;
    if (button.classList.contains('area-more')) {
      toggleArea(button);
      return;
    }
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
    button.closest('.row-body')?.querySelector('.row-streets')?.classList.toggle('open', open);
    button.textContent = open ? 'show less' : 'show all streets';
    paintHits(query());
  });

  fortnight.addEventListener('toggle', (event) => {
    const target = event.target;
    if (target instanceof HTMLDetailsElement && target.matches('[data-more-dates]')) moreDatesOpen = target.open;
  }, true);

  feed.addEventListener('toggle', (event) => {
    const target = event.target;
    if (target instanceof HTMLDetailsElement && target.matches('[data-archive-more]')) archiveOpen = target.open;
  }, true);

  fortnight.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('.fn-day');
    if (!button) return;
    selectedDay = button.dataset.key === selectedDay ? '' : button.dataset.key || '';
    pendingDayJump = selectedDay;
    renderBrowse();
  });

  // Dropping the area scope: the field's clear, "Not my area" and "Show everything" all
  // mean this much. The finished-history action below intentionally keeps the area scoped.
  function resetArea() {
    search.value = '';
    appliedArea = '';
    city = '';
    detected = '';
    forceAnswerAnnouncement = true;
    render();
    search.focus();
  }

  resetBtn.addEventListener('click', resetArea);

  // The x inside the field clears typed text but leaves a deliberately chosen city scope.
  clearInput.addEventListener('click', () => {
    search.value = '';
    appliedArea = '';
    detected = '';
    forceAnswerAnnouncement = true;
    render();
    search.focus();
  });

  // Filter-caused empty states restore only the constraint that hid the rows. Browsing all
  // published interruptions is offered only when a reader supplied a location scope.
  clearBtn.addEventListener('click', () => {
    if (clearBtn.dataset.revealFinished === 'true') {
      showFinished.checked = true;
      renderBrowse();
      showFinished.focus();
      return;
    }
    if (clearBtn.dataset.resetTypes === 'true') {
      for (const input of typeInputs) input.checked = true;
      renderBrowse();
      typeInputs[0]?.focus();
      return;
    }
    if (clearBtn.dataset.clearDay === 'true') {
      selectedDay = '';
      renderBrowse();
      return;
    }
    if (clearBtn.dataset.resetScope === 'true') resetArea();
  });

  function stampFooter(data: Feed) {
    const source = calendarAvailable()
      ? calendar?.checkedAt
        ? `Visayan Electric calendar checked ${clock.format(new Date(calendar.checkedAt))}`
        : 'Visayan Electric calendar checked'
      : !ingestStale()
        ? `Facebook checked ${clock.format(new Date(ingest!.checkedAt!))}`
        : hasTimestamp(ingest?.checkedAt)
          ? `Facebook not checked since ${whenChecked()}`
          : 'Facebook never checked';
    const schedule = sourceReadability === 'unreadable'
      ? 'Schedule unreadable'
      : `${entries.length} ${entries.length === 1 ? 'interruption' : 'interruptions'}`;
    const parts = [
      `Checked ${stampFmt.format(new Date(data.updated))}`,
      source,
      schedule,
      'Cebu time',
    ];
    const latest = !calendarAvailable() && ingest?.latestPostAt
      ? ` Latest Visayan Electric post ${clock.format(new Date(ingest.latestPostAt))}.`
      : '';
    // A half-read source is news, not something to swallow: the API says which row or post
    // could not parse, so the stamp says it too.
    const warningText = data.warnings?.length ? ` ${data.warnings.map((line) => `${line.replace(/\.$/, '')}.`).join(' ')}` : '';
    updated.textContent = `${parts.join(', ')}.${latest}${warningText}`;
  }

  /** Which browse controls have a readable published window behind them. */
  function setChrome(mode: 'loading' | 'ok' | 'failed') {
    chrome = mode;
    const ready = mode === 'ok';
    toolbar.hidden = !ready;
    toolbarNote.hidden = !ready || !selectedTypes().includes('rotational');
    rangeHead.hidden = !ready;
    fortnight.hidden = !ready;
    citiesBox.hidden = !ready;
    if (!ready) {
      emptyNote.hidden = true;
      emptyFeed.hidden = true;
    }

    const from = feedWindow?.from;
    const to = feedWindow?.to;
    rangeHead.textContent = ready && from && to
      ? `Published window: ${monthDay.format(new Date(`${from}T12:00:00+08:00`))} to ${monthDay.format(new Date(`${to}T12:00:00+08:00`))}, Cebu time`
      : 'Published schedule';
  }

  // One load path for the first paint and for every refresh. Nothing on screen is
  // replaced until the payload has parsed, so a failed re-read keeps the last schedule.
  // Returns whether rows moved or the reader's selected day fell outside the newly published
  // window; either requires a full list paint.
  async function load() {
    const response = await fetch('/api/outages');
    if (!response.ok) throw new Error(`feed responded ${response.status}`);
    const data = (await response.json()) as Feed;
    const nextReadability = sourceReadabilityOf(data);
    // A newly unread HTTP 200 must not erase a schedule already on screen. This is a
    // failed refresh, not new data; the initial unread response still reaches its
    // unavailable state below.
    if (nextReadability === 'unreadable' && lastFetch) throw new Error('schedule sources unreadable');

    const sig = JSON.stringify(data.entries || []);
    const moved = sig !== feedSig;
    feedSig = sig;
    entries = data.entries || [];
    byKey = new Map(entries.map((entry) => [keyOf(entry), entry]));
    feedWindow = data.window;
    ingest = data.ingest;
    const dayOutsideWindow = Boolean(
      selectedDay &&
        (!feedWindow?.from || !feedWindow?.to || selectedDay < feedWindow.from || selectedDay > feedWindow.to),
    );
    if (dayOutsideWindow) selectedDay = '';
    calendar = data.calendar;
    warnings = data.warnings || [];
    fyi = fyiOf(data);
    sourceReadability = nextReadability;
    if (sourceReadability !== 'unreadable') lastFetch = Date.now();
    refreshFailed = false;
    fetchedAt = Date.parse(data.updated) || Date.now();
    stampFooter(data);
    return moved || dayOutsideWindow;
  }

  async function reload() {
    if (loading) return;
    const needsRender = chrome !== 'ok';
    loading = true;
    try {
      const moved = await load();
      // A successful retry clears the stale-refresh qualification while preserving opened
      // disclosures when the published entries did not change.
      setChrome(sourceReadability === 'unreadable' ? 'failed' : 'ok');
      if (moved || needsRender) {
        render();
      } else {
        refresh();
      }
    } catch (error) {
      // The last successful schedule beats a blank page, but the confidence line says this
      // refresh failed rather than silently treating retained rows as fresh. A failed
      // whole-feed refresh cannot leave a supplemental operator record looking current.
      refreshFailed = lastFetch > 0;
      fyi = fyiUnavailable();
      console.error(error);
      refresh();
    } finally {
      loading = false;
    }
  }

  // Placeholders on the real row grid: the list's shape is known before its contents are.
  const SKELETON_ROW =
    '<div class="row skel" aria-hidden="true"><div class="row-time"><span class="sk sk-t"></span></div>' +
    '<div class="row-state"></div><div class="row-bar"><span class="sk-bar"></span></div>' +
    '<div class="row-body"><span class="sk sk-a"></span><span class="sk sk-b"></span></div></div>';

  async function boot() {
    setChrome('loading');
    if (browse.open) feed.innerHTML = `<section class="day">${SKELETON_ROW.repeat(3)}</section>`;
    else feed.innerHTML = '';
    try {
      await load();
      setChrome(sourceReadability === 'unreadable' ? 'failed' : 'ok');
      render();
    } catch (error) {
      feed.innerHTML = '';
      entries = [];
      byKey = new Map();
      warnings = [];
      fyi = fyiUnavailable();
      setChrome('failed');
      render();
      updated.textContent = 'Feed unreachable.';
      console.error(error);
    }
  }

  retryBtn.addEventListener('click', () => {
    retryBtn.setAttribute('aria-busy', 'true');
    retryBtn.disabled = true;
    const retry = chrome === 'ok' ? reload() : boot();
    void retry.finally(() => {
      retryBtn.removeAttribute('aria-busy');
      retryBtn.disabled = false;
    });
  });
  browse.addEventListener('toggle', (event) => {
    if (event.target === browse && browse.open) renderBrowse();
  });


  await boot();

  // The tick ages the words, the bars, the rail and the now line; once the payload itself
  // is old it gets re-read, and a tab coming back into view always does. Installed even if
  // the first read failed, so an unreachable feed recovers on its own.
  setInterval(() => {
    if (Date.now() - lastFetch > REFETCH_MS) void reload();
    else refresh();
  }, 60000);

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) void reload();
  });
</script>
