---
import EditionLayout from '../layouts/EditionLayout.astro';
---

<EditionLayout
  noindex
  title="Remote coaching | accoworks.dev"
  description="Remote coaching with Ac: I write your program, check your training and adjust it as you go. $150 USD a month, 3-month commitment. Apply through the form."
>
  <section class="coach" aria-labelledby="coach-title">
    <header class="coach__head">
      <h1 id="coach-title">Remote coaching</h1>
      <p class="coach__slot">1 slot open</p>
      <div class="sidebox">
        <h2 class="sidebox__title">Price</h2>
        <ul>
          <li>$150 USD per month</li>
          <li>About ₱9,300 per month</li>
          <li>3-month commitment</li>
        </ul>
      </div>
    </header>

    <div class="coach__body">
      <div class="coach__copy">
        <p class="coach__open">I coach athletes remotely. I write your program, check your training and adjust it as you go.</p>
        <p>I've coached CrossFit for more than ten years. I own CrossFit Subtero, two gyms in Cebu City, and I'm Country Manager for CrossFit Philippines. I also race HYROX.</p>
        <p class="coach__cred">Credentials: CrossFit Level 3 Trainer, OPEX CCP Level 1.</p>

        <h2>How it works</h2>
        <p>Your program is written for you: your history, your schedule and what you need to work on. You do the training. I check it, ask questions and change the program when it needs changing.</p>

        <h2>Who it is for</h2>
        <p>It is for people who can train on their own and have the equipment they need. If you are new to training and still building the habit, you may get more from a coach in person.</p>

        <h2>Apply</h2>
        <p>Fill in the form below. I read every submission myself. You can also email me at <a href="mailto:ac@accoworks.dev">ac@accoworks.dev</a>.</p>
      </div>

      <noscript>
        <p class="coach__noscript">This form needs JavaScript. Without it, email me at <a href="mailto:ac@accoworks.dev">ac@accoworks.dev</a> instead.</p>
      </noscript>

      <form class="coach__form" id="intake-form" novalidate>
        <fieldset class="fgroup">
          <legend>Who you are</legend>
          <div class="field-row">
            <div class="field">
              <label for="in-name">Name</label>
              <input id="in-name" name="name" type="text" autocomplete="name" required maxlength="200" />
            </div>
            <div class="field">
              <label for="in-email">Email</label>
              <input id="in-email" name="email" type="email" autocomplete="email" required maxlength="200" />
            </div>
          </div>
        </fieldset>

        <fieldset class="fgroup">
          <legend>Where you are</legend>
          <div class="field">
            <label for="in-experience">Experience level</label>
            <select id="in-experience" name="experience">
              <option value="Beginner">Beginner</option>
              <option value="Intermediate" selected>Intermediate</option>
              <option value="Advanced">Advanced</option>
              <option value="Competitive athlete">Competitive athlete</option>
            </select>
          </div>
          <div class="field">
            <label for="in-training">Current training</label>
            <textarea id="in-training" name="training" required maxlength="2000" placeholder="Current training load, and any injuries or limitations."></textarea>
          </div>
        </fieldset>

        <fieldset class="fgroup">
          <legend>What you want</legend>
          <div class="field">
            <label for="in-goal">Goal</label>
            <textarea id="in-goal" name="goal" required maxlength="2000" placeholder="What do you want to achieve?"></textarea>
          </div>
          <div class="field">
            <label for="in-why"><span>Why me</span><span class="opt">Optional</span></label>
            <textarea id="in-why" name="why" maxlength="2000" placeholder="Why do you want to work with me?"></textarea>
          </div>
        </fieldset>

        <div class="field visually-hidden" aria-hidden="true">
          <label for="in-company">Company</label>
          <input id="in-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="coach__submit">
          <button class="btn btn--solid" type="submit" data-submit>Send my application</button>
          <p class="form-status" data-status role="status" aria-live="polite"></p>
        </div>
      </form>

      <div class="sidebox coach__done" data-done hidden tabindex="-1">
        <h2 class="sidebox__title">Received</h2>
        <p>I will reply within 48 hours. If it is a fit, we start with a call.</p>
      </div>
    </div>
  </section>
</EditionLayout>

<script>
  const form = document.getElementById('intake-form') as HTMLFormElement | null;
  const done = document.querySelector<HTMLElement>('[data-done]');

  if (form && done) {
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submitLabel = submitBtn.textContent;

    const setStatus = (message: string, tone: 'neutral' | 'error') => {
      status.textContent = message;
      status.dataset.tone = tone;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') || '').trim(),
        email: String(data.get('email') || '').trim(),
        experience: String(data.get('experience') || ''),
        training: String(data.get('training') || '').trim(),
        goal: String(data.get('goal') || '').trim(),
        why: String(data.get('why') || '').trim(),
        company: String(data.get('company') || ''),
      };

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      setStatus('Sending your application.', 'neutral');

      try {
        const response = await fetch('/api/coaching', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error(`Intake request failed with ${response.status}`);
        form.hidden = true;
        done.hidden = false;
        done.focus?.();
      } catch {
        setStatus('Something went wrong on the way to my inbox. Please try again, or email ac@accoworks.dev directly.', 'error');
        submitBtn.disabled = false;
        submitBtn.textContent = submitLabel;
      }
    });
  }
</script>
