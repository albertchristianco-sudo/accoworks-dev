---
import BaseLayout from '../layouts/BaseLayout.astro';

type Project = {
  name: string;
  status: string;
  scope: string;
  outcome: string;
  stack: string;
  access: string;
  link?: { href: string; label: string };
};

const projects: Project[] = [
  {
    name: 'accoworks.dev',
    status: 'Live · Open source',
    scope: 'Personal site and publishing system',
    outcome: 'Publishes Field Notes and gives Ac’s coaching, operating, and building work one public front door.',
    stack: 'Astro · MDX · Cloudflare Pages',
    access: 'Public',
    link: { href: 'https://github.com/albertchristianco-sudo/accoworks-dev', label: 'View public source' },
  },
  {
    name: 'Cortex Orchestrator',
    status: 'Active · Private',
    scope: 'Approval-gated agent operations',
    outcome: 'Keeps consequential agent actions behind explicit approval before execution.',
    stack: 'Python · LangGraph',
    access: 'Private system',
  },
  {
    name: 'Life Dashboard',
    status: 'In progress · Local',
    scope: 'Personal operations dashboard',
    outcome: 'Version 0.1 renders 2 of 8 planned adapters into one local view of training, business, and daily operations.',
    stack: 'Python · Static web',
    access: 'Local only',
  },
  {
    name: 'Flame & Finish systems',
    status: 'Active · Internal',
    scope: 'Trade operations',
    outcome: 'Keeps inventory, ordering, reporting, and storefront work inside systems built for the trade business.',
    stack: 'Django · WordPress · Automation',
    access: 'Business internal',
  },
  {
    name: 'Gym programming automation',
    status: 'Active · Internal',
    scope: 'Coaching operations',
    outcome: 'Reduces repetitive platform entry while keeping programming decisions with the coach.',
    stack: 'APIs · Python · Scripting',
    access: 'Coaching internal',
  },
];
---

<BaseLayout
  title="Projects | accoworks.dev"
  description="The workbench: ventures, internal systems, and small tools Ac builds across coaching, business, and software."
>
  <section class="page-intro page-intro--folio">
    <span class="page-folio" aria-hidden="true">02 / OPERATIONS</span>
    <p class="kicker">Operating record</p>
    <h1 class="page-title">The workbench.</h1>
    <p class="page-copy">
      Some of this ships in public. Most of it serves a real operation first. This is a record of what the work is for, what exists now, and what remains private.
    </p>
  </section>

  <section class="section" aria-labelledby="project-list-heading">
    <div class="section-head section-head--compact">
      <p class="section-eyebrow"><span class="hash">//</span> current systems</p>
      <h2 id="project-list-heading" class="visually-hidden">Current projects and systems</h2>
    </div>
    <ol class="project-ledger project-timeline">
      {projects.map((project, index) => (
        <li class="project-record">
          <div class="project-record__index">{String(index + 1).padStart(2, '0')}</div>
          <div class="project-record__main">
            <div class="project-record__heading">
              <div>
                <p class="project-record__status">{project.status}</p>
                <h3>{project.name}</h3>
              </div>
              <span class="project-record__access">{project.access}</span>
            </div>
            <p class="project-record__scope">{project.scope}</p>
            <p class="project-record__outcome"><span>Outcome</span>{project.outcome}</p>
            <div class="project-record__footer">
              <span>{project.stack}</span>
              {project.link && (
                <a class="cta-link" href={project.link.href} target="_blank" rel="noopener">
                  {project.link.label}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
                </a>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" aria-labelledby="lab-cta">
    <div class="coaching-cta">
      <div>
        <p class="section-eyebrow"><span class="hash">//</span> field notes</p>
        <h2 id="lab-cta">The systems make more sense in context.</h2>
        <p>Field Notes covers the decisions, trade-offs, and operating lessons behind the work.</p>
      </div>
      <a class="btn btn--primary" href="/field-notes/">
        Read Field Notes
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>
