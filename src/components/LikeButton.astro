---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="like" data-like data-slug={slug} aria-busy="true" hidden>
  <button
    type="button"
    class="like__btn"
    data-like-btn
    aria-pressed="false"
    aria-busy="false"
    aria-label="Like this note. Reaction count loading."
  >
    <span class="like__heart" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false">
        <path d="M12 21s-6.7-4.35-9.33-8.07C1.1 10.7 1.5 7.7 3.6 6.2c1.9-1.36 4.4-.86 5.7.9L12 10l2.7-2.9c1.3-1.76 3.8-2.26 5.7-.9 2.1 1.5 2.5 4.5.93 6.73C18.7 16.65 12 21 12 21z" />
      </svg>
      <span class="like__burst" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i>
      </span>
    </span>
    <span class="like__count" data-like-count>0</span>
  </button>
  <span class="like__label">If this helped, tap the heart.</span>
  <span class="like__status" data-like-status role="status" aria-live="polite"></span>
</div>

<script>
  import { applyLoadedCount, beginReaction, formatReactionCount, readStoredLike, rejectReaction, resolveReaction, writeStoredLike } from '../scripts/reaction-state.mjs';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-like]').forEach((root) => {
    const slug = root.getAttribute('data-slug') || '';
    const btn = root.querySelector<HTMLButtonElement>('[data-like-btn]');
    const countEl = root.querySelector<HTMLElement>('[data-like-count]');
    const statusEl = root.querySelector<HTMLElement>('[data-like-status]');
    if (!slug || !btn || !countEl || !statusEl) return;

    const storeKey = `liked:${slug}`;
    let state = {
      liked: readStoredLike(localStorage, storeKey),
      count: 0,
      busy: false,
      message: 'Loading reactions…',
      tone: 'neutral',
    };
    let loading = true;
    let mutationStarted = false;

    const render = () => {
      countEl.textContent = String(state.count);
      statusEl.textContent = state.message;
      statusEl.dataset.tone = state.tone;
      root.setAttribute('aria-busy', loading || state.busy ? 'true' : 'false');
      btn.classList.toggle('is-liked', state.liked);
      btn.toggleAttribute('disabled', state.busy);
      btn.setAttribute('aria-busy', state.busy ? 'true' : 'false');
      btn.setAttribute('aria-pressed', state.liked ? 'true' : 'false');
      const action = state.liked ? 'Unlike this note' : 'Like this note';
      btn.setAttribute('aria-label', `${action}. ${loading ? 'Reaction count loading.' : formatReactionCount(state.count)}`);
    };

    const burst = () => {
      if (reduceMotion) return;
      btn.classList.remove('is-burst');
      void btn.offsetWidth;
      btn.classList.add('is-burst');
    };

    const load = async () => {
      try {
        const response = await fetch(`/api/reactions?slug=${encodeURIComponent(slug)}`);
        if (!response.ok) throw new Error(`Reaction count request failed with ${response.status}`);
        const data = await response.json();
        state = applyLoadedCount(state, data.likes, mutationStarted);
      } catch {
        if (!mutationStarted) {
          state = {
            ...state,
            message: 'Reaction count unavailable. You can still react.',
            tone: 'error',
          };
        }
      } finally {
        loading = false;
        render();
      }
    };

    btn.addEventListener('click', async () => {
      if (state.busy) return;

      mutationStarted = true;
      loading = false;
      state = beginReaction(state);
      if (state.liked) burst();
      writeStoredLike(localStorage, storeKey, state.liked);
      render();

      try {
        const response = await fetch('/api/reactions', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ slug, action: state.liked ? 'like' : 'unlike' }),
        });
        if (!response.ok) throw new Error(`Reaction request failed with ${response.status}`);
        const data = await response.json();
        state = resolveReaction(state, data.likes);
      } catch {
        state = rejectReaction(state);
        writeStoredLike(localStorage, storeKey, state.liked);
      }

      render();
    });

    root.hidden = false;
    render();
    load();
  });
</script>
