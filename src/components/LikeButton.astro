---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="like" data-like data-slug={slug}>
  <button
    type="button"
    class="like__btn"
    data-like-btn
    aria-pressed="false"
    aria-label="Like this note"
  >
    <span class="like__heart" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false">
        <path
          d="M12 21s-6.7-4.35-9.33-8.07C1.1 10.7 1.5 7.7 3.6 6.2c1.9-1.36 4.4-.86 5.7.9L12 10l2.7-2.9c1.3-1.76 3.8-2.26 5.7-.9 2.1 1.5 2.5 4.5.93 6.73C18.7 16.65 12 21 12 21z"
        />
      </svg>
      <span class="like__burst" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i>
      </span>
    </span>
    <span class="like__count" data-like-count>0</span>
  </button>
  <span class="like__label">Liked this? Tap the heart.</span>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-like]').forEach((root) => {
    const slug = root.getAttribute('data-slug') || '';
    const btn = root.querySelector<HTMLButtonElement>('[data-like-btn]');
    const countEl = root.querySelector<HTMLElement>('[data-like-count]');
    if (!slug || !btn || !countEl) return;

    const storeKey = `liked:${slug}`;
    let liked = localStorage.getItem(storeKey) === '1';
    let count = 0;
    let busy = false;

    const render = () => {
      countEl.textContent = String(count);
      btn.classList.toggle('is-liked', liked);
      btn.setAttribute('aria-pressed', liked ? 'true' : 'false');
      btn.setAttribute('aria-label', liked ? 'Unlike this note' : 'Like this note');
    };

    const burst = () => {
      if (reduceMotion) return;
      btn.classList.remove('is-burst');
      void btn.offsetWidth;
      btn.classList.add('is-burst');
    };

    const load = async () => {
      try {
        const res = await fetch(`/api/reactions?slug=${encodeURIComponent(slug)}`);
        if (!res.ok) return;
        const data = await res.json();
        count = Number(data.likes) || 0;
        render();
      } catch {
        /* offline or function unavailable: leave at 0 */
      }
    };

    btn.addEventListener('click', async () => {
      if (busy) return;
      busy = true;

      const next = !liked;
      // optimistic update
      liked = next;
      count = Math.max(0, count + (next ? 1 : -1));
      if (next) burst();
      render();
      localStorage.setItem(storeKey, next ? '1' : '0');

      try {
        const res = await fetch('/api/reactions', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ slug, action: next ? 'like' : 'unlike' }),
        });
        if (res.ok) {
          const data = await res.json();
          count = Number(data.likes) || 0;
          render();
        }
      } catch {
        /* keep optimistic value */
      } finally {
        busy = false;
      }
    });

    render();
    load();
  });
</script>
