---
import { isoDay, noteHref, shortDate, type Note } from '../../lib/notes';

interface Props {
  notes: Note[];
  // Gives the first entry the larger lead treatment.
  lead?: boolean;
  // Adds data-label to each item so the archive filter can target it.
  labelled?: boolean;
  class?: string;
}

const { notes, lead = false, labelled = false, class: className } = Astro.props;
---

<ol class:list={['toc', className]}>
  {notes.map((note, index) => (
    <li class:list={['toc__item', { 'toc__item--lead': lead && index === 0 }]} data-label={labelled ? note.data.label : undefined}>
      <a href={noteHref(note)}>
        <span class="toc__meta">
          <span class="toc__label">{note.data.label}</span> <time datetime={isoDay(note.data.date)}>{shortDate(note.data.date)}</time>
        </span>
        <span class="toc__title">{note.data.title}</span>
        <span class="toc__sum">{note.data.summary}</span>
      </a>
    </li>
  ))}
</ol>
