---
import '@fontsource/barlow-semi-condensed/latin-600.css';
import '@fontsource/barlow-semi-condensed/latin-700.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  minimalNav?: boolean;
  noindex?: boolean;
}

const {
  title = 'Ac | Founder. Builder. Coach.',
  description = 'Ac is a founder, builder, coach, and operator in Cebu City, Philippines. Two CrossFit boxes, Country Manager for CrossFit Philippines, a building materials business, and a workbench of tools.',
  image = '/og.png',
  ogType = 'website',
  minimalNav = false,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://accoworks.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content="#F5F7FB" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="accoworks.dev" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png" />
    <link rel="apple-touch-icon" href="/icon-180.png" />

  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header" aria-label="Site header">
        <a class="brand-mark" href="/" aria-label="accoworks home">
          <span class="brand-tile" aria-hidden="true"><span class="brand-ac">ac</span><span class="brand-caret"></span></span>
          <span class="brand-wm">accoworks<span class="brand-tld">.dev</span></span>
        </a>
        {!minimalNav && (
          <div class="nav-cluster">
            <nav class="site-nav" aria-label="Primary navigation">
              <a class="nav-link" href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>
              <a class="nav-link" href="/projects/" aria-current={isActive('/projects') ? 'page' : undefined}>Projects</a>
              <a class="nav-link" href="/field-notes/" aria-current={isActive('/field-notes') ? 'page' : undefined}>Field Notes</a>
              <a class="nav-link" href="/power/" aria-current={isActive('/power') ? 'page' : undefined}>Power</a>
              <a class="nav-link" href="mailto:ac@accoworks.dev">Email</a>
            </nav>
          </div>
        )}
      </header>

      <main id="main-content" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-grid">
          <span class="footer-meta">Cebu City, Philippines · Training, building, operating.</span>
          <div class="footer-links">
            <a href="/projects/">Projects</a>
            <a href="/field-notes/">Field Notes</a>
            <a href="https://github.com/albertchristianco-sudo" rel="me noopener" target="_blank">GitHub</a>
            <a href="mailto:ac@accoworks.dev">ac@accoworks.dev</a>
          </div>
          <span class="footer-meta">© {year} accoworks</span>
        </div>
      </footer>
    </div>

  </body>
</html>
